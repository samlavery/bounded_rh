    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      ((3725000000 * HD 1 - 14200000) / 3700097957 - ε) * (Zeta23.Ncount T (2 * T) : ℝ) ≤ Zeta23.N0simple T (2 * T) := by
  rw [← Phi_WW, ← WW_B]
  exact n_point_bound_w' 8 ((701466 : ℝ) / 100000000) 149 WW (by norm_num) (by norm_num) WW_adm
    (by norm_num : (0 : ℝ) < (32954 : ℝ) / 100000000) WW_bmin (by norm_num) cert_WW (by norm_num)

