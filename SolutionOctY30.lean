  unfold OctY30.G; ring_nf

/-- the half-space certificate, completed by reflection (the weights are symmetric) -/
theorem cert_full : ∀ x0 x1 x2 x3 x4 x5 x6 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 → 0 ≤ x5 → 0 ≤ x6 → (OctY30.cN : ℝ) / OctY30.SA ≤ OctY30.G x0 x1 x2 x3 x4 x5 x6 := by
  intro x0 x1 x2 x3 x4 x5 x6 h0 h1 h2 h3 h4 h5 h6
  rcases lt_or_ge x6 x0 with hlt | hle
  · rcases OctY30Data.cert x6 x5 x4 x3 x2 x1 x0 h6 h5 h4 h3 h2 h1 h0 with h | h
    · rw [← G_rev]; exact h
    · exact absurd h (not_lt.mpr hlt.le)
  · rcases OctY30Data.cert x0 x1 x2 x3 x4 x5 x6 h0 h1 h2 h3 h4 h5 h6 with h | h
    · exact h
    · exact absurd h (not_lt.mpr hle)

/-- the certificate hypothesis of `n_point_bound_w'` at `n = 8` -/
theorem cert_WW : ∀ g : Fin (8 - 1) → ℝ, (∀ i, 0 ≤ g i) → (701466 : ℝ) / 100000000 ≤ Fw WW g := by
  intro g hg
  rw [Fw_WW]
  have h := cert_full (g 0) (g 1) (g 2) (g 3) (g 4) (g 5) (g 6) (hg 0) (hg 1) (hg 2) (hg 3) (hg 4) (hg 5) (hg 6)
  simp only [OctY30.cN, OctY30.SA] at h
  push_cast at h
  exact h

