     · rw [← SZ.v_mul]; exact (SZ.v_min_le_left _ _).trans (SZ.v_min_le_right _ _)
     · rw [← SZ.v_mul]; exact (SZ.v_min_le_right _ _).trans (SZ.v_min_le_left _ _)
     · rw [← SZ.v_mul]; exact (SZ.v_min_le_right _ _).trans (SZ.v_min_le_right _ _)
