   exact this.congr_left fun T => by simp only [hR₁]; ring
 have hcinv_bd : ∀ᶠ T in atTop, 0 ≤ cinv T ∧ cinv T ≤ 2 * c⁻¹ := by
   have hcpos : (0:ℝ) < c⁻¹ := inv_pos.mpr hc0
