     have h := hfr2 T hT₂
     simp only at h
     have h1 : trG2 T / (aT T * P.L T) ^ 2 - cinv T * N T ≤ C₂ * P.calE T * (cinv T * N T) := by
       rw [← mul_assoc] at h
