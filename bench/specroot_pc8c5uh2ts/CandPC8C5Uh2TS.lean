theorem gsum_sub (g : ℕ → ℝ) {a b : ℕ} (h : a ≤ b) : gsum g a b = gsum g 0 b - gsum g 0 a := by
 have := gsum_add g (Nat.zero_le a) h; linarith
theorem cast_ov_oadd (x y : Option ℕ) : ((ov (oadd x y) : ℕ) : ℝ) = (ov x : ℝ) + (ov y : ℝ) := by
