     (IV.enc_scl (CJ c.j0).2 (CJ c.j0).1 (IV.enc_mulc PIC_enc (by simp [PIC, IV.ofN, SZ.v]) hG))
   have hj0' : c.j0 = c.k / 2 := rfl
   have hv := CJ_val (j := c.j0) (by rw [hj0']; omega) (by rw [hj0']; omega)
   rw [hj0'] at hv
   convert hS using 1
   rw [hj0', ← hv, Nat.mul_eq]; push_cast; ring
