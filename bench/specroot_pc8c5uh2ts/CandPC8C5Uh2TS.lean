   exact Finset.sum_nonneg fun r hr =>
     le_trans (div_nonneg (Nat.cast_nonneg _) SC_pos.le) (hb r (by have := hPR k hk; simp at hr; omega)).1
 · obtain ⟨hij, hjQ⟩ := hPR k hk
   have h1 := sum_hi hb (pI PR k) (pJ PR k - pI PR k) (by omega)
