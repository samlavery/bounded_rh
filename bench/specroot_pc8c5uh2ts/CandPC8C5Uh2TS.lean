         rw [this]; gcongr; exact ha2.1
 have o5 := err_isLittleO (R₁ := R₁) (R₂ := R₂) (NII := fun T => (NII Z T : ℝ)) (B := B)
   (cl := cinv) hNtop o1 o2 o3 o4 hcinv_bd
