       = ((aT T * P.L T)⁻¹) ^ 2 * trG2 T := by
     rw [frobSq_hat, hGG, frobSq_tilde_Gp, hidfr, hida]; rfl
   have haL : (AMW.atAM P T).a T * (AMW.atAM P T).L T = aT T * P.L T := by rw [hida]; rfl
   rw [hrt, hfr, haL] at hA
