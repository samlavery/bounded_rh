def sI (Q : ℕ) (PR : List (ℕ × ℕ)) (s : ℕ) : ℕ := if s < Q then s else pI PR (s - Q)
def sJ (Q : ℕ) (PR : List (ℕ × ℕ)) (s : ℕ) : ℕ := if s < Q then s + 1 else pJ PR (s - Q)
def sLo (Q : ℕ) (c : Cl) (s : ℕ) : ℕ := if s < Q then c.L.getD s 0 else c.A.getD (s - Q) 0
