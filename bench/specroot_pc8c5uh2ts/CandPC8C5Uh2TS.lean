     = deriv (deriv (fP p L)) u * fP p L u + 2 * (deriv (fP p L) u * deriv (fP p L) u)
       + fP p L u * deriv (deriv (fP p L)) u := by
   rw [← hev2.deriv_eq]; exact deriv2_mul_eq hU hsm hsm huU
