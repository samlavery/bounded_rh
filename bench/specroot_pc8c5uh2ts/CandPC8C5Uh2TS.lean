   ext t
   simp only [mem_image, mem_univ, true_and]
   constructor
   · rintro ⟨i, rfl⟩
     exact ⟨i.1, i.2, rfl⟩
   · rintro ⟨i, hi, rfl⟩
     exact ⟨⟨i, hi⟩, rfl⟩
