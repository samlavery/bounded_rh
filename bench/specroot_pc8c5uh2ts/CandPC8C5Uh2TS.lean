theorem N2_enc (hc : c.ok = true) {x : ℝ} (hx1 : (c.LN : ℝ) / SC ≤ x) (hx2 : x ≤ (c.UN : ℝ) / SC) :
   c.N2.Enc (mN2 x) := by
 have b := c.base_sound hc hx1 hx2
