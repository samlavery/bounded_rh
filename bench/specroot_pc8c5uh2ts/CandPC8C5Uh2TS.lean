       ≤ min (min (I.lo.v * J.lo.v) (I.lo.v * J.hi.v)) (min (I.hi.v * J.lo.v) (I.hi.v * J.hi.v)) := by
     refine le_min (le_min ?_ ?_) (le_min ?_ ?_)
