/-
Semantic equivalence of the variants: `force a k = k a`, hence variant B's (and variant C's) `termWN`,
`leafCheck` and `walk` are equal, as functions, to variant A's (verbatim) ones. Bodies below are the
`BenchBDefs.lean` / `BenchCDefs.lean` text with `_B` / `_C` suffixes (generated by sed).
-/
import BenchADefs

universe u

/-- evaluate a natural-number argument to a numeral once, then continue -/
def force {α : Sort u} (a : ℕ) (k : ℕ → α) : α :=
  Nat.casesOn (motive := fun _ => α) a (k 0) (fun n => k (Nat.succ n))

-- ===== variant B (renamed) =====
namespace Zeta23Ext.Bridge.ThreePoint

def termWNcore_B (t : CTN) (lo hi : ℕ) (ps : List (ℕ × ℕ)) : ℕ :=
  match lookupAllN t ps with
  | some cs => if chainOKN lo hi cs then chainWN cs else 0
  | none => 0

def termWN_B (t : CTN) (lo hi : ℕ) : ℕ :=
  force lo fun lo => force hi fun hi => termWNcore_B t lo hi (piecesN' lo hi)

end Zeta23Ext.Bridge.ThreePoint

namespace Zeta23Ext.Bridge.ThreePoint.SixW7

def leafCheck_B (tb : CTN) (b : Box) : Bool :=
  force b.l0 fun l0 => force b.l1 fun l1 => force b.l2 fun l2 => force b.l3 fun l3 => force b.l4 fun l4 =>
  force b.u0 fun u0 => force b.u1 fun u1 => force b.u2 fun u2 => force b.u3 fun u3 => force b.u4 fun u4 =>
  force (l0 + l1) fun l01 => force (l01 + l2) fun l02 => force (l02 + l3) fun l03 => force (l03 + l4) fun l04 =>
  force (l1 + l2) fun l12 => force (l12 + l3) fun l13 => force (l13 + l4) fun l14 =>
  force (l2 + l3) fun l23 => force (l23 + l4) fun l24 =>
  force (l3 + l4) fun l34 =>
  force (u0 + u1) fun u01 => force (u01 + u2) fun u02 => force (u02 + u3) fun u03 => force (u03 + u4) fun u04 =>
  force (u1 + u2) fun u12 => force (u12 + u3) fun u13 => force (u13 + u4) fun u14 =>
  force (u2 + u3) fun u23 => force (u23 + u4) fun u24 =>
  force (u3 + u4) fun u34 =>
  Nat.ble (cN * SC * SW) ((24896 * l0 + 42034 * l1 + 46137 * l2 + 42034 * l3 + 24896 * l4) * SW + (25326800 * termWN_B tb l0 u0 + 62369200 * termWN_B tb l01 u01 + 40126500 * termWN_B tb l02 u02 + 99999900 * termWN_B tb l03 u03 + 200000000 * termWN_B tb l04 u04 + 48244400 * termWN_B tb l1 u1 + 37630700 * termWN_B tb l12 u12 + 119746800 * termWN_B tb l13 u13 + 99999900 * termWN_B tb l14 u14 + 52857300 * termWN_B tb l2 u2 + 37630700 * termWN_B tb l23 u23 + 40126500 * termWN_B tb l24 u24 + 48244400 * termWN_B tb l3 u3 + 62369200 * termWN_B tb l34 u34 + 25326800 * termWN_B tb l4 u4) * SC)

def walk_B (tb : CTN) (bits : ℕ) : ℕ → ℕ → Box → Option ℕ
  | 0, _, _ => none
  | fuel + 1, pos, b =>
      bif bits.testBit pos then
        let ax := axOf bits pos
        let q := b.mid ax
        match walk_B tb bits fuel (pos + 4) (b.setHi ax q) with
        | none => none
        | some pos' => walk_B tb bits fuel pos' (b.setLo ax q)
      else bif Nat.blt b.u4 b.l0 || leafCheck_B tb b then some (pos + 1) else none

end Zeta23Ext.Bridge.ThreePoint.SixW7

-- ===== variant C (renamed) =====
namespace Zeta23Ext.Bridge.ThreePoint

def piecesNF : ℕ → ℕ → ℕ → List (ℕ × ℕ)
  | 0, a, hi => [(roundFar a hi)]
  | fuel + 1, a, hi =>
      force (((a >>> 13) + 1) <<< 13) fun q =>
      bif Nat.blt q hi then (roundFar a q) :: piecesNF fuel q hi else [(roundFar a hi)]

def lookupAllNF (t : CTN) : List (ℕ × ℕ) → Option (List CellN)
  | [] => some []
  | (a, b) :: rest =>
      force (a * KB + b) fun key =>
      match t.find key, lookupAllNF t rest with
      | some c, some cs => some (c :: cs)
      | _, _ => none

def chainWNF : List CellN → ℕ
  | [] => 0
  | c :: rest => force (chainWNF rest) fun m =>
      bif rest.isEmpty then c.WN else bif Nat.ble c.WN m then c.WN else m

def termWNcore_C (t : CTN) (lo hi : ℕ) (ps : List (ℕ × ℕ)) : ℕ :=
  match lookupAllNF t ps with
  | some cs => if chainOKN lo hi cs then chainWNF cs else 0
  | none => 0

def termWN_C (t : CTN) (lo hi : ℕ) : ℕ :=
  force lo fun lo => force hi fun hi => termWNcore_C t lo hi (piecesNF 64 lo hi)

end Zeta23Ext.Bridge.ThreePoint

namespace Zeta23Ext.Bridge.ThreePoint.SixW7

def leafCheck_C (tb : CTN) (b : Box) : Bool :=
  force b.l0 fun l0 => force b.l1 fun l1 => force b.l2 fun l2 => force b.l3 fun l3 => force b.l4 fun l4 =>
  force b.u0 fun u0 => force b.u1 fun u1 => force b.u2 fun u2 => force b.u3 fun u3 => force b.u4 fun u4 =>
  force (l0 + l1) fun l01 => force (l01 + l2) fun l02 => force (l02 + l3) fun l03 => force (l03 + l4) fun l04 =>
  force (l1 + l2) fun l12 => force (l12 + l3) fun l13 => force (l13 + l4) fun l14 =>
  force (l2 + l3) fun l23 => force (l23 + l4) fun l24 =>
  force (l3 + l4) fun l34 =>
  force (u0 + u1) fun u01 => force (u01 + u2) fun u02 => force (u02 + u3) fun u03 => force (u03 + u4) fun u04 =>
  force (u1 + u2) fun u12 => force (u12 + u3) fun u13 => force (u13 + u4) fun u14 =>
  force (u2 + u3) fun u23 => force (u23 + u4) fun u24 =>
  force (u3 + u4) fun u34 =>
  Nat.ble (cN * SC * SW) ((24896 * l0 + 42034 * l1 + 46137 * l2 + 42034 * l3 + 24896 * l4) * SW + (25326800 * termWN_C tb l0 u0 + 62369200 * termWN_C tb l01 u01 + 40126500 * termWN_C tb l02 u02 + 99999900 * termWN_C tb l03 u03 + 200000000 * termWN_C tb l04 u04 + 48244400 * termWN_C tb l1 u1 + 37630700 * termWN_C tb l12 u12 + 119746800 * termWN_C tb l13 u13 + 99999900 * termWN_C tb l14 u14 + 52857300 * termWN_C tb l2 u2 + 37630700 * termWN_C tb l23 u23 + 40126500 * termWN_C tb l24 u24 + 48244400 * termWN_C tb l3 u3 + 62369200 * termWN_C tb l34 u34 + 25326800 * termWN_C tb l4 u4) * SC)

def walk_C (tb : CTN) (bits : ℕ) : ℕ → ℕ → Box → Option ℕ
  | 0, _, _ => none
  | fuel + 1, pos, b =>
      bif bits.testBit pos then
        force (axOf bits pos) fun ax => force (b.mid ax) fun q => force (pos + 4) fun p4 =>
        match walk_C tb bits fuel p4 (b.setHi ax q) with
        | none => none
        | some pos' => walk_C tb bits fuel pos' (b.setLo ax q)
      else bif Nat.blt b.u4 b.l0 || leafCheck_C tb b then some (pos + 1) else none

end Zeta23Ext.Bridge.ThreePoint.SixW7

-- ===== equivalence proofs =====
theorem force_eq {α : Sort u} (a : ℕ) (k : ℕ → α) : force a k = k a := by cases a <;> rfl

namespace Zeta23Ext.Bridge.ThreePoint

theorem termWN_B_eq (t : CTN) (lo hi : ℕ) : termWN_B t lo hi = termWN t lo hi := by
  simp only [termWN_B, termWN, force_eq, termWNcore_B, termWNcore]; (try rfl)

theorem piecesNF_eq : ∀ fuel a hi, piecesNF fuel a hi = piecesN fuel a hi
  | 0, a, hi => by simp only [piecesNF, piecesN]
  | fuel + 1, a, hi => by simp only [piecesNF, piecesN, force_eq, piecesNF_eq fuel]

theorem lookupAllNF_eq (t : CTN) : ∀ ps, lookupAllNF t ps = lookupAllN t ps
  | [] => by simp only [lookupAllNF, lookupAllN]
  | (a, b) :: rest => by simp only [lookupAllNF, lookupAllN, force_eq, lookupAllNF_eq t rest]; (try rfl)

theorem chainWNF_eq : ∀ cs, chainWNF cs = chainWN cs
  | [] => by simp only [chainWNF, chainWN]
  | c :: rest => by simp only [chainWNF, chainWN, force_eq, chainWNF_eq rest]

theorem termWN_C_eq (t : CTN) (lo hi : ℕ) : termWN_C t lo hi = termWN t lo hi := by
  simp only [termWN_C, termWN, force_eq, termWNcore_C, termWNcore, piecesNF_eq, lookupAllNF_eq, chainWNF_eq, piecesN']; (try rfl)

end Zeta23Ext.Bridge.ThreePoint

namespace Zeta23Ext.Bridge.ThreePoint.SixW7

theorem leafCheck_B_eq (tb : CTN) (b : Box) : leafCheck_B tb b = leafCheck tb b := by
  simp only [leafCheck_B, leafCheck, force_eq, termWN_B_eq]

theorem leafCheck_C_eq (tb : CTN) (b : Box) : leafCheck_C tb b = leafCheck tb b := by
  simp only [leafCheck_C, leafCheck, force_eq, termWN_C_eq]

theorem walk_B_eq (tb : CTN) (bits : ℕ) : ∀ fuel pos b, walk_B tb bits fuel pos b = walk tb bits fuel pos b
  | 0, _, _ => by simp only [walk_B, walk]
  | fuel + 1, pos, b => by simp only [walk_B, walk, leafCheck_B_eq, walk_B_eq tb bits fuel]; (try rfl)

theorem walk_C_eq (tb : CTN) (bits : ℕ) : ∀ fuel pos b, walk_C tb bits fuel pos b = walk tb bits fuel pos b
  | 0, _, _ => by simp only [walk_C, walk]
  | fuel + 1, pos, b => by simp only [walk_C, walk, force_eq, leafCheck_C_eq, walk_C_eq tb bits fuel]; (try rfl)

end Zeta23Ext.Bridge.ThreePoint.SixW7

