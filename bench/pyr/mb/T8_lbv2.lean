def fld (X i : ℕ) : ℕ := Nat.land (Nat.shiftRight X (Nat.mul 32 i)) 4294967295

/-- the entry for level-`l` cell `i` (`l ≤ 10`) from the constant `X` of its block `j`: the entry of its ancestor
