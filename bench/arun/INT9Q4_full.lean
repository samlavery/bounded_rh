theorem PC9QB4_half (y0 y1 y2 y3 y4 y5 y6 y7 : ℝ) (h0 : 0 ≤ y0) (h1 : 0 ≤ y1) (h2 : 0 ≤ y2) (h3 : 0 ≤ y3) (h4 : 0 ≤ y4) (h5 : 0 ≤ y5) (h6 : 0 ≤ y6) (h7 : 0 ≤ y7) :
    (PC9QB4.cN : ℝ) / PC9QB4.SA ≤ PC9QB4.G y0 y1 y2 y3 y4 y5 y6 y7 ∨ y7 < y0 := by
  have hg : ∀ r < 8, 0 ≤ (fun r => [y0, y1, y2, y3, y4, y5, y6, y7].getD r 0) r := by
    intro r hr; interval_cases r <;> simpa
