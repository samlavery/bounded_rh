theorem AMT8_G_rev (x0 x1 x2 x3 x4 x5 x6 : ℝ) : AMT8.G x6 x5 x4 x3 x2 x1 x0 = AMT8.G x0 x1 x2 x3 x4 x5 x6 := by
  unfold AMT8.G; ring_nf

/-- **the AM 8-point certificate**: the half-space certificate completed by reflection (symmetric weights) -/
theorem AMT8_cert_full : ∀ x0 x1 x2 x3 x4 x5 x6 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 → 0 ≤ x5 → 0 ≤ x6 →
    (AMT8.cN : ℝ) / AMT8.SA ≤ AMT8.G x0 x1 x2 x3 x4 x5 x6 := by
  intro x0 x1 x2 x3 x4 x5 x6 h0 h1 h2 h3 h4 h5 h6
  rcases lt_or_ge x6 x0 with hlt | hle
  · rcases AMT8Data.cert x6 x5 x4 x3 x2 x1 x0 h6 h5 h4 h3 h2 h1 h0 with h | h
    · rw [← AMT8_G_rev]; exact h
    · exact absurd h (not_lt.mpr hlt.le)
  · rcases AMT8Data.cert x0 x1 x2 x3 x4 x5 x6 h0 h1 h2 h3 h4 h5 h6 with h | h
    · exact h
    · exact absurd h (not_lt.mpr hle)

