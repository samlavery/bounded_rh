/-- field `i` (EB = 32 bits) of a packed natural -/
def fld (X i : ℕ) : ℕ := Nat.land (Nat.shiftRight X (Nat.mul 32 i)) 4294967295

/-- the entry for level-`l` cell `i` (l ≤ 10) from the constant `X` of its block `j = i >>> (10 - l)`:
the entry of the cell itself if the block is stored that fine, else of its ancestor at the block's finest level -/
def entB (X l i j : ℕ) : ℕ :=
  forceN (Nat.land X 31) fun r =>
  forceN (bif Nat.ble l r then r else l) fun kk =>
  forceN (Nat.sub 10 kk) fun d =>
  fld (Nat.shiftRight X 5) (Nat.add (Nat.sub (Nat.shiftLeft 1 d) 1) (Nat.sub (Nat.shiftRight i (Nat.sub kk l)) (Nat.shiftLeft j d)))

/-- the entry for level-`l` cell `i` -/
def entry (l i : ℕ) : ℕ :=
  bif Nat.blt 19 l then 0
  else bif Nat.blt 10 l then fld TOP (Nat.add (Nat.shiftLeft 1 (Nat.sub 19 l)) i)
  else forceN (Nat.shiftRight i (Nat.sub 10 l)) fun j => entB (BK j) l i j

def alignK1 (g ib : ℕ) : ℕ :=
  bif Nat.beq (Nat.land g 1) 0 && Nat.ble (Nat.add g 2) (Nat.succ ib) then 1 else 0
def alignK2 (g ib : ℕ) : ℕ :=
  bif Nat.beq (Nat.land g 3) 0 && Nat.ble (Nat.add g 4) (Nat.succ ib) then 2 else alignK1 g ib
def alignK3 (g ib : ℕ) : ℕ :=
  bif Nat.beq (Nat.land g 7) 0 && Nat.ble (Nat.add g 8) (Nat.succ ib) then 3 else alignK2 g ib
def alignK4 (g ib : ℕ) : ℕ :=
  bif Nat.beq (Nat.land g 15) 0 && Nat.ble (Nat.add g 16) (Nat.succ ib) then 4 else alignK3 g ib

/-- min of the entries over the aligned cover of the level-`k` cells `g .. ib` (0 if the fuel runs out) -/
def dcov (k ib : ℕ) (fuel : ℕ) : ℕ → ℕ :=
  Nat.rec (motive := fun _ => ℕ → ℕ) (fun _ => 0)
    (fun _ ih g =>
      forceN (alignK4 g ib) fun t =>
      forceN (entry (Nat.add k t) (Nat.shiftRight g t)) fun v =>
      forceN (Nat.add g (Nat.shiftLeft 1 t)) fun g' =>
      bif Nat.blt ib g' then v else forceN (ih g') fun w => bif Nat.ble v w then v else w)
    fuel

/-- bit length of `w < 2^32` -/
def bl0 (w acc : ℕ) : ℕ := bif Nat.ble 1 w then Nat.succ acc else acc
def bl1 (w acc : ℕ) : ℕ := bif Nat.ble 2 w then bl0 (Nat.shiftRight w 1) (Nat.add acc 1) else bl0 w acc
def bl2 (w acc : ℕ) : ℕ := bif Nat.ble 4 w then bl1 (Nat.shiftRight w 2) (Nat.add acc 2) else bl1 w acc
def bl3 (w acc : ℕ) : ℕ := bif Nat.ble 16 w then bl2 (Nat.shiftRight w 4) (Nat.add acc 4) else bl2 w acc
def bl4 (w acc : ℕ) : ℕ := bif Nat.ble 256 w then bl3 (Nat.shiftRight w 8) (Nat.add acc 8) else bl3 w acc
def bitLen (w : ℕ) : ℕ := bif Nat.ble 65536 w then bl4 (Nat.shiftRight w 16) 16 else bl4 w 0

/-- the lower-bound oracle: `lb lo hi / 10000000000` bounds `wfun` below on `[lo, hi] / 2^15` (0 when `hi ≤ lo` or `2^19 < hi`) -/
def lb (lo hi : ℕ) : ℕ :=
  bif Nat.ble hi lo || Nat.blt 524288 hi then 0 else
  forceN (Nat.sub (bitLen (Nat.sub hi lo)) 5) fun k =>
  forceN (Nat.shiftRight (Nat.sub hi 1) k) fun ib =>
  dcov k ib 14 (Nat.shiftRight lo k)

