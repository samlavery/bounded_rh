    · rw [← AMX01_G_rev]; exact h
    · exact absurd h (not_lt.mpr hlt.le)
  · rcases AMX01Data.cert x0 x1 x2 x3 x4 h0 h1 h2 h3 h4 with h | h
    · exact h
    · exact absurd h (not_lt.mpr hle)

