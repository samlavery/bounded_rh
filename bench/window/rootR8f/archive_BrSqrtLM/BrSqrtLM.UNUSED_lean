import AMW.BrProf

/-! ###### the √ band branch (am-cert)

The band profile of Gebendorfer, "Zeta Geometry and Class Cap" (preprint), Lemma 3.3 (AMTOPA's finite trace-corrected
band profile), with the Fenchel multiplier on the boundary `αρ = 1` of its proof: `ρ = √(E/τ)` bounds the band part `Y`
in operator norm, so `A₀ = 2αY` with `α = √(τ/E)` satisfies `A₀ ⪯ 2I` with no diagonal correction (`d = 0`), and
`defect ≥ (2α − α²) E = 2√(τE) − τ` for `E > τ`. The profile is `sqProf τ E = E` (`E ≤ τ`), `2√(τE) − τ` (`E > τ`):
nondecreasing, 1-Lipschitz, below the identity.
* `band_key_herm`: `defect ≥ (2α − α²) E` whenever `α ≥ 0` and `α² E ≤ τ`, from bridge-port's `bp_fenchel` and
  `bp_band_quad` (the steps of `band_profile_herm`, for a general multiplier).
* `band_profile_sq`: `sqProf τ E_band ≤ defect`.
* the τ chain of `AMW.BrTau` with `sqProf` in place of `min τ`: since `sqProf` is nondecreasing and 1-Lipschitz, the
  block bound `sqProf τ (c(m−q)) − η ≤ blockDefect + pressure` needs no cap on `c(m−q)`; then the eventual block
  bound, the solve, `Phi_sq`, and the dyadic bound `AMW.am_dyadic_n_sq`.
* `Phi_sq_ge_sqrt` / `Phi_sq_ge_lin`: the final numeric step from a rational lower bound `s` with `s² ≤ τ c(m−q)`.
This √ branch was first used on riemannzeta.fun by dani-ani0 (dani-bound-2026). The proof here is an independent
derivation from Gebendorfer's Lemma 3.3 / AMTOPA, on this repository's `BrProf` and `BrTau`. ###### -/

noncomputable section
set_option linter.unusedSectionVars false

open Matrix Finset RHLinalg
open scoped ComplexOrder BigOperators

namespace Zeta23Ext.BridgeW

open Zeta23Ext.Bridge Zeta23Ext.StableRankTrace

/-! ### the profile -/

/-- the √ band profile: `E` up to `τ`, then `2√(τE) − τ` -/
def sqProf (τ E : ℝ) : ℝ := if E ≤ τ then E else 2 * Real.sqrt (τ * E) - τ

lemma sqProf_low {τ E : ℝ} (h : E ≤ τ) : sqProf τ E = E := if_pos h

lemma sqProf_high {τ E : ℝ} (h : τ < E) : sqProf τ E = 2 * Real.sqrt (τ * E) - τ := if_neg (not_le.mpr h)

/-- above `τ`, `√(τE) ≥ τ` -/
lemma sqrt_tau_mul_ge {τ E : ℝ} (hτ : 0 < τ) (h : τ ≤ E) : τ ≤ Real.sqrt (τ * E) :=
  (Real.le_sqrt' hτ).mpr (by nlinarith)

/-- `2√(τE) ≤ τ + E`: the product `(2s − τ − E)(2s + τ + E) = −(τ − E)²` with `s² = τE` -/
lemma sqProf_le_self {τ : ℝ} (hτ : 0 < τ) (E : ℝ) : sqProf τ E ≤ E := by
  unfold sqProf
  split_ifs with h
  · exact le_rfl
  · rw [not_le] at h
    have hE : 0 < E := hτ.trans h
    have hs := Real.sq_sqrt (by positivity : (0 : ℝ) ≤ τ * E)
    have hpos : 0 < 2 * Real.sqrt (τ * E) + τ + E := by positivity
    nlinarith [sq_nonneg (τ - E)]

lemma sqProf_nonneg {τ E : ℝ} (hτ : 0 < τ) (hE : 0 ≤ E) : 0 ≤ sqProf τ E := by
  unfold sqProf
  split_ifs with h
  · exact hE
  · rw [not_le] at h
    linarith [sqrt_tau_mul_ge hτ h.le]

lemma sqProf_pos {τ E : ℝ} (hτ : 0 < τ) (hE : 0 < E) : 0 < sqProf τ E := by
  unfold sqProf
  split_ifs with h
  · exact hE
  · rw [not_le] at h
    linarith [sqrt_tau_mul_ge hτ h.le]

lemma sqProf_mono {τ x y : ℝ} (hτ : 0 < τ) (hxy : x ≤ y) : sqProf τ x ≤ sqProf τ y := by
  unfold sqProf
  split_ifs with hx hy hy
  · exact hxy
  · rw [not_le] at hy
    linarith [sqrt_tau_mul_ge hτ hy.le]
  · exact absurd (hxy.trans hy) hx
  · rw [not_le] at hx hy
    have := Real.sqrt_le_sqrt (by nlinarith : τ * x ≤ τ * y)
    linarith

/-- `sqProf` is 1-Lipschitz -/
lemma sqProf_lip {τ x y : ℝ} (hτ : 0 < τ) (hxy : x ≤ y) : sqProf τ y - sqProf τ x ≤ y - x := by
  unfold sqProf
  split_ifs with hy hx hx
  · exact le_rfl
  · exact absurd (hxy.trans hy) hx
  · rw [not_le] at hy
    have := sqProf_le_self hτ y
    rw [sqProf_high hy] at this
    linarith
  · rw [not_le] at hx hy
    set a := Real.sqrt (τ * x) with ha
    set b := Real.sqrt (τ * y) with hb
    have ha2 : a ^ 2 = τ * x := Real.sq_sqrt (by nlinarith)
    have hb2 : b ^ 2 = τ * y := Real.sq_sqrt (by nlinarith)
    have haτ : τ ≤ a := sqrt_tau_mul_ge hτ hx.le
    have hab : a ≤ b := Real.sqrt_le_sqrt (by nlinarith)
    have key : τ * (2 * (b - a)) ≤ τ * (y - x) := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hab) (by linarith : (0 : ℝ) ≤ b + a - 2 * τ)]
    have := le_of_mul_le_mul_left key hτ
    linarith

/-! ### the profile inequality -/

section BandSq

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

lemma bandSq_nonneg (G : Matrix κ κ ℂ) (r : κ → ℕ) (q : ℕ) : 0 ≤ bandSq G r q :=
  sum_nonneg fun _ _ => sum_nonneg fun _ _ => by split_ifs <;> positivity

/-- `defect ≥ (2α − α²) E_band` for every multiplier `α ≥ 0` with `α² E_band ≤ τ` (the Fenchel bound at `A = 2αY`;
the steps of bridge-port's `band_profile_herm`, for a general `α`) -/
theorem band_key_herm {G : Matrix κ κ ℂ} (hG : G.IsHermitian) (r : κ → ℕ) (hr : Function.Injective r)
    (q : ℕ) (hq : 1 ≤ q) (α : ℝ) (hα : 0 ≤ α) (hαE : α ^ 2 * bandSq G r q ≤ ((q : ℝ) + 1) / q) :
    (2 * α - α ^ 2) * bandSq G r q ≤ defect hG := by
  obtain ⟨U, hUU, hUU', hG1⟩ : ∃ U : Matrix κ κ ℂ, U * star U = 1 ∧ star U * U = 1 ∧
      G - 1 = U * diagonal (fun i => ((hG.eigenvalues i - 1 : ℝ) : ℂ)) * star U :=
    ⟨_, Matrix.mem_unitaryGroup_iff.mp hG.eigenvectorUnitary.2, Matrix.mem_unitaryGroup_iff'.mp hG.eigenvectorUnitary.2,
      by rw [← specMap_sub_one hG]; unfold specMap; rw [Unitary.conjStarAlgAut_apply]; rfl⟩
  have hYG : rtrace (bpBand G r q * (G - 1)) = bandSq G r q := by
    unfold rtrace bandSq
    simp only [Matrix.trace, Matrix.diag_apply, Matrix.mul_apply, map_sum, RCLike.re_to_complex]
    refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
    simp only [bpBand]
    split_ifs with hb
    · rw [Matrix.sub_apply, Matrix.one_apply_ne (Ne.symm hb.1), sub_zero, ← hG.apply j i, RCLike.star_def,
        RCLike.mul_conj]
      norm_cast
    · simp
  have hYY : rtrace (bpBand G r q * (bpBand G r q)ᴴ) = bandSq G r q := by
    rw [rtrace_self_mul_conjTranspose, sum_comm]
    unfold bandSq
    refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
    simp only [bpBand]
    split_ifs <;> simp
  obtain ⟨E, hE⟩ : ∃ E, bandSq G r q = E := ⟨_, rfl⟩
  obtain ⟨τ, hτ⟩ : ∃ τ : ℝ, ((q : ℝ) + 1) / q = τ := ⟨_, rfl⟩
  rw [hE]
  rw [hE, hτ] at hαE
  rw [hE] at hYG hYY
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq
  have hτ0 : 0 < τ := by rw [← hτ]; exact div_pos (by linarith) hq0
  have hcol : ∀ i, ∑ j, ‖U j i‖ ^ 2 = 1 := by
    intro i
    have hre : ∀ z : ℂ, (star z * z).re = ‖z‖ ^ 2 := fun z => by
      rw [Complex.sq_norm, Complex.normSq_apply, Complex.star_def, Complex.mul_re, Complex.conj_re, Complex.conj_im]
      ring
    have h := congrArg Complex.re (congrFun (congrFun hUU' i) i)
    simp only [Matrix.mul_apply, Matrix.star_apply, Matrix.one_apply_eq, Complex.re_sum, Complex.one_re] at h
    simpa only [hre] using h
  have hz : ∀ i, ‖(star U * bpBand G r q * U) i i‖ ^ 2 * τ ≤ E := by
    intro i
    have hexp : (star U * bpBand G r q * U) i i = ∑ j, ∑ k, star (U j i) * bpBand G r q j k * U k i := by
      simp only [Matrix.mul_apply, Matrix.star_apply, sum_mul]
      exact sum_comm
    have hb := bp_band_quad G r hr q (fun j => U j i)
    beta_reduce at hb
    rw [hcol i, one_pow, mul_one, hE] at hb
    rw [hexp]
    calc ‖∑ j, ∑ k, star (U j i) * bpBand G r q j k * U k i‖ ^ 2 * τ ≤ E * ((q : ℝ) / (q + 1)) * τ := by
          gcongr
      _ = E := by rw [← hτ]; field_simp
  have hF := bp_fenchel hG U hUU hG1 ((((2 * α : ℝ)) : ℂ) • bpBand G r q) (fun i => by
    rw [Matrix.mul_smul, Matrix.smul_mul, Matrix.smul_apply, smul_eq_mul, Complex.re_ofReal_mul]
    have h1 := Complex.re_le_norm ((star U * bpBand G r q * U) i i)
    have h2 : (α * ‖(star U * bpBand G r q * U) i i‖) ^ 2 ≤ 1 := by
      have h4 : α ^ 2 * (‖(star U * bpBand G r q * U) i i‖ ^ 2 * τ) ≤ α ^ 2 * E :=
        mul_le_mul_of_nonneg_left (hz i) (sq_nonneg α)
      have h5 : (α * ‖(star U * bpBand G r q * U) i i‖) ^ 2 * τ ≤ 1 * τ := by nlinarith
      exact le_of_mul_le_mul_right h5 hτ0
    have h3 : α * ‖(star U * bpBand G r q * U) i i‖ ≤ 1 := by
      nlinarith [mul_nonneg hα (norm_nonneg ((star U * bpBand G r q * U) i i))]
    nlinarith)
  have h1 : rtrace ((((2 * α : ℝ)) : ℂ) • bpBand G r q * (G - 1)) = 2 * α * E := by
    rw [Matrix.smul_mul]
    unfold rtrace at hYG ⊢
    rw [Matrix.trace_smul, smul_eq_mul, RCLike.re_to_complex, Complex.re_ofReal_mul, ← RCLike.re_to_complex, hYG]
  have h2 : rtrace ((((2 * α : ℝ)) : ℂ) • bpBand G r q * ((((2 * α : ℝ)) : ℂ) • bpBand G r q)ᴴ)
      = 4 * α ^ 2 * E := by
    rw [conjTranspose_smul, Complex.star_def, Complex.conj_ofReal, Matrix.smul_mul, Matrix.mul_smul, smul_smul]
    unfold rtrace at hYY ⊢
    rw [Matrix.trace_smul, smul_eq_mul, ← Complex.ofReal_mul, RCLike.re_to_complex, Complex.re_ofReal_mul,
      ← RCLike.re_to_complex, hYY]
    ring
  rw [h1, h2] at hF
  linarith

/-- **the √ band profile**: `sqProf τ E_band ≤ defect`, `τ = (q+1)/q`; for `E > τ` the multiplier is `α = √(τ/E)`
(the boundary `αρ = 1` of Lemma 3.3's proof) -/
theorem band_profile_sq {G : Matrix κ κ ℂ} (hG : G.IsHermitian) (r : κ → ℕ) (hr : Function.Injective r)
    (q : ℕ) (hq : 1 ≤ q) : sqProf (((q : ℝ) + 1) / q) (bandSq G r q) ≤ defect hG := by
  have hτ0 : (0 : ℝ) < ((q : ℝ) + 1) / q := by
    have : (0 : ℝ) < q := by exact_mod_cast hq
    exact div_pos (by linarith) this
  rcases le_or_gt (bandSq G r q) (((q : ℝ) + 1) / q) with h | h
  · rw [sqProf_low h]
    have := band_key_herm hG r hr q hq 1 zero_le_one (by simpa using h)
    linarith
  · rw [sqProf_high h]
    set τ := ((q : ℝ) + 1) / q with hτ
    set E := bandSq G r q with hEdef
    have hEpos : 0 < E := hτ0.trans h
    set α := Real.sqrt (τ / E) with hαdef
    have hα2 : α ^ 2 = τ / E := Real.sq_sqrt (by positivity)
    have hkey := band_key_herm hG r hr q hq α (Real.sqrt_nonneg _)
      (le_of_eq (by rw [hα2, div_mul_cancel₀ _ hEpos.ne']))
    have hαE : α * E = Real.sqrt (τ * E) := by
      have hτE : τ * E = τ / E * E ^ 2 := by
        have : τ / E * E ^ 2 = τ * E := by rw [pow_two, ← mul_assoc, div_mul_cancel₀ _ hEpos.ne']
        exact this.symm
      rw [hτE, Real.sqrt_mul (div_nonneg hτ0.le hEpos.le), Real.sqrt_sq hEpos.le]
    calc 2 * Real.sqrt (τ * E) - τ = (2 * α - α ^ 2) * E := by
          rw [sub_mul, mul_assoc, hαE, hα2, div_mul_cancel₀ _ hEpos.ne']
      _ ≤ defect hG := hkey

end BandSq

/-! ### the block bound, uncapped -/

/-- **`block_bound_w'` with the √ band profile**: `sqProf τ (c(m−q)) − 2m²δ ≤ blockDefect + pressure` for every `c`
(no cap): the band energy `E` of the block satisfies `c(m−q) − 2m²δ ≤ E + P`, and `sqProf` is nondecreasing and
1-Lipschitz with `sqProf τ E ≤ defect` -/
theorem block_bound_w'_sq {κ : Type} [Fintype κ] [DecidableEq κ] {c : ℝ} {n m : ℕ}
    (hn : 2 ≤ n) (hm : n ≤ m) (W : WCert n) (hW : W.Adm)
    (hCert : ∀ g : Fin (n - 1) → ℝ, (∀ i, 0 ≤ g i) → c ≤ Fw W g)
    (x : κ → ℝ) {G : Matrix κ κ ℂ} (hG : G.PosSemidef) (B : Finset κ) (hB : B.card = m)
    (hx : Set.InjOn x B) {δ : ℝ} (hδ : 0 ≤ δ)
    (hclose : ∀ i ∈ B, ∀ j ∈ B, i ≠ j → ‖G i j - (kfun (x i - x j) : ℂ)‖ ≤ δ) :
    sqProf ((((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ)) (c * ((m : ℝ) - ((n : ℝ) - 1))) - 2 * (m : ℝ) ^ 2 * δ
      ≤ blockDefect hG.1 B + blkPress W.b x B := by
  classical
  set x' : B → ℝ := fun i => x i with hx'def
  have hx' : Function.Injective x' := fun i j h => Subtype.ext (hx i.2 j.2 h)
  have hcard : Fintype.card B = m := by simp [hB]
  have hS : (univ.image x').card = m := by rw [card_image_of_injective _ hx', card_univ, hcard]
  have hE := block_energy_band hn W hW hCert hm x' hx' hS
  have himg : (univ : Finset B).image (fun i : B => x i) = B.image x := by
    ext t
    simp only [mem_image, mem_univ, true_and]
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i.1, i.2, rfl⟩
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, rfl⟩
  have hPe : blkPress W.b x' univ = blkPress W.b x B := by
    unfold blkPress sortedOn
    rw [sortedOn_congr himg, himg]
  rw [hPe] at hE
  have hcl' : ∀ i j : B, i ≠ j → ‖G.submatrix (Subtype.val : B → κ) (Subtype.val : B → κ) i j - (kfun (x' i - x' j) : ℂ)‖ ≤ δ :=
    fun i j h => hclose i i.2 j j.2 (fun e => h (Subtype.ext e))
  have hC := band_close hx' hS hcard (n - 1) (G.submatrix (Subtype.val : B → κ) (Subtype.val : B → κ)) hδ hcl'
  have hτ0 : (0 : ℝ) < (((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ) := by
    have : (0 : ℝ) < ((n - 1 : ℕ) : ℝ) := by exact_mod_cast (by omega : 0 < n - 1)
    exact div_pos (by linarith) this
  have hprof : sqProf ((((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ))
      (bandSq (G.submatrix (Subtype.val : B → κ) (Subtype.val : B → κ)) (fun i => (sRank x' hS i : ℕ)) (n - 1))
        ≤ blockDefect hG.1 B :=
    band_profile_sq (hG.submatrix _).1 (fun i => (sRank x' hS i : ℕ))
      (fun i j h => sRank_injective hx' hS (Fin.ext h)) (n - 1) (by omega)
  have hP0 : 0 ≤ blkPress W.b x B := by
    unfold blkPress
    refine sum_nonneg fun r _ => mul_nonneg (hW.b_nonneg r) ?_
    unfold sortedOn
    have hic : (B.image x).card = m := by rw [card_image_of_injOn hx, hB]
    have hr2 := r.2
    have hr : (r : ℕ) < (B.image x).card := by rw [hic]; omega
    have hk : (B.image x).card - (n - 1) + r < (B.image x).card := by rw [hic]; omega
    have hmono := ((B.image x).orderEmbOfFin rfl).strictMono
    rw [sub_nonneg, sortedExt_of_lt _ hk, sortedExt_of_lt _ hr]
    exact hmono.monotone (Fin.mk_le_mk.mpr (by omega))
  have hm2 : (0 : ℝ) ≤ 2 * (m : ℝ) ^ 2 * δ := by positivity
  set τ := (((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ) with hτ
  set A := c * ((m : ℝ) - ((n : ℝ) - 1)) with hA
  set E := bandSq (G.submatrix (Subtype.val : B → κ) (Subtype.val : B → κ)) (fun i => (sRank x' hS i : ℕ)) (n - 1)
    with hEdef
  -- the band energy and the sorted pair sum: `A − 2m²δ ≤ E + P`
  have hAE : A - 2 * (m : ℝ) ^ 2 * δ ≤ E + blkPress W.b x B := by linarith
  rcases le_or_gt A E with h | h
  · linarith [sqProf_mono hτ0 h]
  · linarith [sqProf_lip hτ0 h.le]

/-! ### the chain -/

section SqChain

open Filter Zeta23 Zeta23.ZeroSide Zeta23.ThmD
open Classical

/-- the effective block constant `sqProf τ (c(m−q))`, `τ = (q+1)/q`, `q = n − 1` -/
def sqEff (n : ℕ) (c : ℝ) (m : ℕ) : ℝ :=
  sqProf ((((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ)) (c * ((m : ℝ) - ((n : ℝ) - 1)))

/-- the √-branch constant `Φ = (H − B(m−q)/m) / (1 − sqProf τ (c(m−q))/m)` -/
def Phi_sq (n : ℕ) (c : ℝ) (m : ℕ) (B : ℝ) : ℝ :=
  (AMW.HW - B * ((m : ℝ) - ((n : ℝ) - 1)) / m) / (1 - sqEff n c m / m)

lemma tau_n_pos {n : ℕ} (hn : 2 ≤ n) : (0 : ℝ) < (((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ) := by
  have : (0 : ℝ) < ((n - 1 : ℕ) : ℝ) := by exact_mod_cast (by omega : 0 < n - 1)
  exact div_pos (by linarith) this

lemma sqEff_le {n : ℕ} (hn : 2 ≤ n) (c : ℝ) (m : ℕ) : sqEff n c m ≤ c * ((m : ℝ) - ((n : ℝ) - 1)) :=
  sqProf_le_self (tau_n_pos hn) _

theorem solve_linear_sq {N N0 : ℝ → ℝ} {F : ℝ} {m : ℕ} (K : ℝ) (hD : 0 < 1 - F / m)
    (h : ∀ ε > 0, ∀ᶠ T in atTop, (K - ε) * N T ≤ (1 - F / m) * N0 T) :
    ∀ ε > 0, ∀ᶠ T in atTop, (K / (1 - F / m) - ε) * N T ≤ N0 T := by
  intro ε hε
  set Dn : ℝ := 1 - F / m with hDn
  filter_upwards [h (ε * Dn) (mul_pos hε hD)] with T hT
  have : K / Dn - ε = (K - ε * Dn) / Dn := by
    field_simp
  rw [this, div_mul_eq_mul_div, div_le_iff₀ hD]
  linarith

theorem block_bound_eventually_w'_sq (Z : ZeroConfig) (H : PaperInputs Z) {c : ℝ} {n m : ℕ}
    (hn3 : 3 ≤ n) (h2n : 2 * n ≤ m) (W : WCert n) (hW : W.Adm)
    {bmin : ℝ} (hbmin : 0 < bmin) (hb : ∀ r, bmin ≤ W.b r)
    (hCert : ∀ g : Fin (n - 1) → ℝ, (∀ i, 0 ≤ g i) → c ≤ Fw W g)
    {η : ℝ} (hη : 0 < η) :
    ∀ᶠ T in atTop, ∀ B : Finset (retained Z (mtParams T) T), B.card = m →
      sqEff n c m - η ≤ blockDefect (gram_isHermitian Z (mtParams T) T) B
        + blkPress W.b (xret Z (mtParams T) T) B := by
  have hn : 2 ≤ n := by omega
  have hm : n ≤ m := by omega
  have hm' : (2 : ℝ) ≤ m := by exact_mod_cast (by omega : 2 ≤ m)
  have hmsq : 0 < 2 * (m : ℝ) ^ 2 := by positivity
  set δ : ℝ := η / (2 * (m : ℝ) ^ 2) with hδ
  have hδpos : 0 < δ := div_pos hη hmsq
  filter_upwards [kernel_limit Z H (|c * ((m : ℝ) - ((n : ℝ) - 1))| / bmin) δ hδpos, eventually_L_pos]
    with T hclose hL
  intro B hB
  set x := xret Z (mtParams T) T with hx
  have hinj : Set.InjOn x B := (xret_injective Z (mtParams T) T hL).injOn
  by_cases hsp : spanOf x B ≤ |c * ((m : ℝ) - ((n : ℝ) - 1))| / bmin
  · have hcl : ∀ i ∈ B, ∀ j ∈ B, i ≠ j →
        ‖gram Z (mtParams T) T i j - (Bridge.kfun (x i - x j) : ℂ)‖ ≤ δ := by
      intro i hi j hj _
      exact hclose i j ((abs_sub_le_spanOf x hi hj).trans hsp)
    have h13 := block_bound_w'_sq hn hm W hW hCert x (gram_posSemidef Z (mtParams T) T) B hB
      hinj hδpos.le hcl
    have hη' : 2 * (m : ℝ) ^ 2 * δ = η := by rw [hδ]; field_simp
    rw [hη'] at h13
    exact h13
  · rw [not_le] at hsp
    have hP := spanOf_le_blkPress_div hn3 h2n W.b hbmin hb x B hB hinj
    have hP1 : |c * ((m : ℝ) - ((n : ℝ) - 1))| < blkPress W.b x B := by
      have := (lt_of_lt_of_le hsp hP)
      rw [lt_div_iff₀ hbmin] at this
      rw [div_mul_cancel₀ _ hbmin.ne'] at this
      exact this
    have hle : sqEff n c m ≤ |c * ((m : ℝ) - ((n : ℝ) - 1))| := (sqEff_le hn c m).trans (le_abs_self _)
    linarith [blockDefect_nonneg (gram_isHermitian Z (mtParams T) T) B]

theorem pre_solve_w'_sq (Z : ZeroConfig) (H : PaperInputs Z) {c : ℝ} {n m : ℕ}
    (hn3 : 3 ≤ n) (h2n : 2 * n ≤ m) (W : WCert n) (hW : W.Adm)
    {bmin : ℝ} (hbmin : 0 < bmin) (hb : ∀ r, bmin ≤ W.b r) (hc : 0 < c)
    (hCert : ∀ g : Fin (n - 1) → ℝ, (∀ i, 0 ≤ g i) → c ≤ Fw W g) :
    ∀ ε > 0, ∀ᶠ T in atTop,
      (AMW.HW - W.B * ((m : ℝ) - ((n : ℝ) - 1)) / m - ε) * (Z.N T (2 * T) : ℝ)
        ≤ (1 - sqEff n c m / m) * (Z.N0s T (2 * T) : ℝ) := by
  intro ε hε
  have hn : 2 ≤ n := by omega
  have hm : n ≤ m := by omega
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hmn : (n : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hm' : (2 : ℝ) ≤ m := le_trans hn' hmn
  have hmpos : (0 : ℝ) < m := by linarith
  have hmq : (1 : ℝ) ≤ (m : ℝ) - ((n : ℝ) - 1) := by linarith
  have hFpos : 0 < sqEff n c m := sqProf_pos (tau_n_pos hn) (mul_pos hc (by linarith))
  have hq0 : (0 : ℝ) ≤ W.B := WCert.B_nonneg hW
  set Cn : ℝ := (m : ℝ) + (2 * sqEff n c m + 1) + W.B * ((m : ℝ) - ((n : ℝ) - 1)) with hCn
  have hCnpos : 0 < Cn := by
    have h := mul_nonneg hq0 (by linarith : (0 : ℝ) ≤ (m : ℝ) - ((n : ℝ) - 1))
    rw [hCn]; nlinarith
  set ε₀ : ℝ := ε * (m : ℝ) / Cn with hε₀
  have hε₀pos : 0 < ε₀ := by rw [hε₀]; positivity
  have hηpos : 0 < min ε₀ (sqEff n c m) := lt_min hε₀pos hFpos
  have hηε : min ε₀ (sqEff n c m) ≤ ε₀ := min_le_left _ _
  have hηF : min ε₀ (sqEff n c m) ≤ sqEff n c m := min_le_right _ _
  have hA' : 0 ≤ sqEff n c m - min ε₀ (sqEff n c m) := by linarith
  filter_upwards [block_bound_eventually_w'_sq Z H hn3 h2n W hW hbmin hb hCert hηpos,
    deleted_strips Z H _ hηpos, span_retained_le Z H _ hηpos,
    tail_passage Z H (eventually_h7 Z) _ hηpos,
    (Assembly.tendsto_N_atTop Z H.RvM).eventually_ge_atTop ((m : ℝ) / min ε₀ (sqEff n c m)),
    eventually_L_pos] with T hblk hstrip hspan h8 hNbig hL
  have h15 := offset_average_w hn W.b hW.b_nonneg (xret Z (mtParams T) T)
    (xret_injective Z (mtParams T) T hL) hm
    (blockDefect (gram_isHermitian Z (mtParams T) T))
    (Dcirc Z (mtParams T) T)
    (sqEff n c m - min ε₀ (sqEff n c m))
    hA' (blockDefect_nonneg _) (fun B hB _ => hblk B hB)
    (fun κ _ _ β => pinching_partition (gram_isHermitian Z (mtParams T) T) κ β)
  rw [Fintype.card_coe] at h15
  have hBeq : (∑ r, W.b r) = W.B := rfl
  rw [hBeq] at h15
  have hN0 : (0 : ℝ) ≤ (Z.N T (2 * T) : ℝ) := Nat.cast_nonneg _
  have hn0N : (Z.N0s T (2 * T) : ℝ) ≤ (Z.N T (2 * T) : ℝ) := by
    have h := (Z.trivial_chain T (2 * T)).1.trans
      ((Z.trivial_chain T (2 * T)).2.1.trans (Z.trivial_chain T (2 * T)).2.2.1)
    exact_mod_cast h
  have hmN : (m : ℝ) ≤ min ε₀ (sqEff n c m) * (Z.N T (2 * T) : ℝ) := by
    have := (div_le_iff₀ hηpos).mp hNbig; linarith
  set F : ℝ := sqEff n c m with hF
  set q : ℝ := W.B with hq
  set mq : ℝ := (m : ℝ) - ((n : ℝ) - 1) with hmqdef
  set η : ℝ := min ε₀ F with hη
  set N : ℝ := (Z.N T (2 * T) : ℝ) with hNdef
  set n0 : ℝ := (Z.N0s T (2 * T) : ℝ) with hn0def
  set S : ℝ := ((retained Z (mtParams T) T).card : ℝ) with hSdef
  set D : ℝ := Dcirc Z (mtParams T) T with hDdef
  set sp : ℝ := spanOf (xret Z (mtParams T) T) univ with hspdef
  clear_value F q mq η N n0 S D sp
  have step1 : (F - η) * (n0 - 2 * η * N) ≤ (F - η) * (S - m) :=
    mul_le_mul_of_nonneg_left (by linarith) hA'
  have hmq0 : (0 : ℝ) ≤ mq := by linarith
  have step2 : q * mq * sp ≤ q * mq * ((1 + η) * N) :=
    mul_le_mul_of_nonneg_left hspan (mul_nonneg hq0 hmq0)
  have hηN : 0 ≤ η * N := mul_nonneg hηpos.le hN0
  have e2 : η * n0 ≤ η * N := mul_le_mul_of_nonneg_left hn0N hηpos.le
  have e3 : 0 ≤ η * η * N := mul_nonneg (mul_nonneg hηpos.le hηpos.le) hN0
  have step3 : F * n0 - (2 * F + 1) * η * N ≤ (F - η) * (n0 - 2 * η * N) := by nlinarith [e2, e3]
  have hmD : (m : ℝ) * D ≤ m * (n0 - (AMW.HW - η) * N) :=
    mul_le_mul_of_nonneg_left (by linarith) hmpos.le
  have hcoef1 : η * ((m : ℝ) + (2 * F + 1) + q * mq) ≤ η * Cn :=
    mul_le_mul_of_nonneg_left (by rw [hCn]) hηpos.le
  have hcoef2 : η * Cn ≤ ε₀ * Cn := mul_le_mul_of_nonneg_right hηε hCnpos.le
  have hεCn : ε₀ * Cn = ε * (m : ℝ) := by
    rw [hε₀]; field_simp
  have hcoef : η * ((m : ℝ) + (2 * F + 1) + q * mq) ≤ m * ε := by
    linarith [hcoef1, hcoef2, hεCn]
  have hηN' : η * ((m : ℝ) + (2 * F + 1) + q * mq) * N ≤ m * ε * N :=
    mul_le_mul_of_nonneg_right hcoef hN0
  have key : ((m : ℝ) * AMW.HW - q * mq - m * ε) * N ≤ ((m : ℝ) - F) * n0 := by
    linarith [h15, step1, step2, step3, hmD, hηN']
  have hL1 : (AMW.HW - q * mq / m - ε) * N
      = ((m : ℝ) * AMW.HW - q * mq - m * ε) * N / m := by
    field_simp
  have hR1 : (1 - F / m) * n0 = ((m : ℝ) - F) * n0 / m := by
    field_simp
  rw [hL1, hR1]
  exact div_le_div_of_nonneg_right key hmpos.le

theorem n_point_bound_w'_sq (n : ℕ) (c : ℝ) (m : ℕ) (W : WCert n) (hn3 : 3 ≤ n) (h2n : 2 * n ≤ m)
    (hW : W.Adm) {bmin : ℝ} (hbmin : 0 < bmin) (hb : ∀ r, bmin ≤ W.b r) (hc : 0 < c)
    (hCert : ∀ g : Fin (n - 1) → ℝ, (∀ i, 0 ≤ g i) → c ≤ Fw W g) (hFm : sqEff n c m < m) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (Phi_sq n c m W.B - ε) * (Zeta23.Ncount T (2 * T) : ℝ) ≤ Zeta23.N0simple T (2 * T) := by
  have hmpos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have hD : 0 < 1 - sqEff n c m / m := by rw [sub_pos, div_lt_one hmpos]; exact hFm
  have h := solve_linear_sq (N := fun T => (Zeta23.Ncount T (2 * T) : ℝ))
    (N0 := fun T => (Zeta23.N0simple T (2 * T) : ℝ)) (AMW.HW - W.B * ((m : ℝ) - ((n : ℝ) - 1)) / m) hD
    (by
      have := pre_solve_w'_sq zetaZeroConfig paperInputs_zeta hn3 h2n W hW hbmin hb hc hCert
      simpa only [zetaZeroConfig_N, zetaZeroConfig_N0s] using this)
  intro ε hε
  exact eventually_atTop.mp (h ε hε)

/-! ### the final numeric step -/

/-- `κ ≤ Phi_sq` from a rational lower bound `s` of `√(τ c(m−q))` (the case `c(m−q) > τ`); `H ≥ 67216841/10⁸` -/
theorem Phi_sq_ge_sqrt {n : ℕ} {c B κ s : ℝ} {m : ℕ} (hn : 2 ≤ n) (hm : 0 < m)
    (hhigh : (((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ) < c * ((m : ℝ) - ((n : ℝ) - 1)))
    (hlt : c * ((m : ℝ) - ((n : ℝ) - 1)) < m) (hκ : 0 ≤ κ)
    (hs : s ^ 2 ≤ (((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ) * (c * ((m : ℝ) - ((n : ℝ) - 1))))
    (h : κ * (1 - (2 * s - (((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ)) / m)
      ≤ 67216841 / 10 ^ 8 - B * ((m : ℝ) - ((n : ℝ) - 1)) / m) :
    κ ≤ Phi_sq n c m B := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  set τ := (((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ) with hτ
  set A := c * ((m : ℝ) - ((n : ℝ) - 1)) with hA
  have hF : sqEff n c m = 2 * Real.sqrt (τ * A) - τ := sqProf_high hhigh
  have hsle : s ≤ Real.sqrt (τ * A) := (le_abs_self s).trans (Real.abs_le_sqrt hs)
  have hFm : sqEff n c m < m := lt_of_le_of_lt (sqEff_le hn c m) hlt
  have hD : 0 < 1 - sqEff n c m / m := by rw [sub_pos, div_lt_one hm']; exact hFm
  unfold Phi_sq
  rw [le_div_iff₀ hD]
  have hmono : κ * (1 - sqEff n c m / m) ≤ κ * (1 - (2 * s - τ) / m) := by
    refine mul_le_mul_of_nonneg_left ?_ hκ
    rw [hF]
    have : (2 * s - τ) / m ≤ (2 * Real.sqrt (τ * A) - τ) / m := div_le_div_of_nonneg_right (by linarith) hm'.le
    linarith
  linarith [AMW.HW_ge]

/-- `κ ≤ Phi_sq` in the case `c(m−q) ≤ τ` (the profile is the identity there) -/
theorem Phi_sq_ge_lin {n : ℕ} {c B κ : ℝ} {m : ℕ} (hm : 0 < m)
    (hlow : c * ((m : ℝ) - ((n : ℝ) - 1)) ≤ (((n - 1 : ℕ) : ℝ) + 1) / ((n - 1 : ℕ) : ℝ))
    (hlt : c * ((m : ℝ) - ((n : ℝ) - 1)) < m)
    (h : κ * (1 - c * ((m : ℝ) - ((n : ℝ) - 1)) / m) ≤ 67216841 / 10 ^ 8 - B * ((m : ℝ) - ((n : ℝ) - 1)) / m) :
    κ ≤ Phi_sq n c m B := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hF : sqEff n c m = c * ((m : ℝ) - ((n : ℝ) - 1)) := sqProf_low hlow
  have hD : 0 < 1 - sqEff n c m / m := by rw [hF, sub_pos, div_lt_one hm']; exact hlt
  unfold Phi_sq
  rw [le_div_iff₀ hD, hF]
  linarith [AMW.HW_ge]

end SqChain

end Zeta23Ext.BridgeW

end


noncomputable section

namespace AMW

open Filter Zeta23 Zeta23Ext.Bridge Zeta23Ext.BridgeW

/-- **The n-point bound for the AM window under the √ band profile**, from a certificate; no cap on `c(m−q)` -/
theorem am_dyadic_n_sq {n : ℕ} (hn : 3 ≤ n) {W : WCert n} (hW : W.Adm) {bmin : ℝ}
    (hbmin : 0 < bmin) (hb : ∀ r, bmin ≤ W.b r) {c κ : ℝ} {m : ℕ} (hc : 0 < c) (hm : 2 * n ≤ m)
    (hlt : c * ((m : ℝ) - ((n : ℝ) - 1)) < m)
    (hκ : κ ≤ Phi_sq n c m W.B)
    (hCert : ∀ g : Fin (n - 1) → ℝ, (∀ i, 0 ≤ g i) → c ≤ Fw W g) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (κ - ε) * (Zeta23.Ncount T (2 * T) : ℝ) ≤ Zeta23.N0star T (2 * T) := by
  intro ε hε
  have hFm : sqEff n c m < m := lt_of_le_of_lt (sqEff_le (by omega) c m) hlt
  obtain ⟨T₀, hT₀⟩ := n_point_bound_w'_sq n c m W hn hm hW hbmin hb hc hCert hFm ε hε
  refine ⟨T₀, fun T hT => ?_⟩
  have h1 := hT₀ T hT
  have hN : (0:ℝ) ≤ (Zeta23.Ncount T (2 * T) : ℝ) := Nat.cast_nonneg _
  have h2 : (Zeta23.N0simple T (2 * T) : ℝ) ≤ Zeta23.N0star T (2 * T) := by
    exact_mod_cast N0simple_le_N0star' T (2 * T)
  have h0 : (κ - ε) * (Zeta23.Ncount T (2 * T) : ℝ) ≤ (Phi_sq n c m W.B - ε) * (Zeta23.Ncount T (2 * T) : ℝ) :=
    mul_le_mul_of_nonneg_right (by linarith) hN
  linarith

end AMW

end
