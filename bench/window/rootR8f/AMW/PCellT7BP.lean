/-- (bench) the AMT8 box leaf on the gap bounds -/
def leafStep (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (pos w : ℕ) : ST :=
  fun l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 l5 u5 l6 u6 A02 B02 A03 B03 A04 B04 A05 B05 A06 B06 A07 B07 A13 B13 A14 B14 A15 B15 A16 B16 A17 B17 A24 B24 A25 B25 A26 B26 A27 B27 A35 B35 A36 B36 A37 B37 A46 B46 A47 B47 A57 B57 M => AMW.Cert.AMT8.leafStep top bk tD bD pb R pos w l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 l5 u5 l6 u6

/-- a node: bit `pos` selects split (`[1]`, then the axis codeword; the children from the bit after it) or leaf (`[0]`) -/
def node (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (bits : ℕ) (ih : WF) (pos : ℕ) : ST :=
  Bool.rec (motive := fun _ => ST) (leafStep top bk tD bD pb R pos (Nat.shiftRight bits pos))
    (forceT (hdecL 15 HLA HCA HSA bits (Nat.add pos 1)) fun al => splitAx ih (Nat.add (Nat.add pos 1) (Nat.shiftRight al 16)) (Nat.land al 65535))
    (Nat.beq (Nat.land (Nat.shiftRight bits pos) 1) 1)

/-- the walk: every node is first tightened (an empty node ends there, no bits) -/
def walk (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (bits fuel : ℕ) : WF :=
  Nat.rec (motive := fun _ => WF) (fun _ => zK) (fun _ ih pos => T1 pos (node top bk tD bD pb R bits ih pos)) fuel


