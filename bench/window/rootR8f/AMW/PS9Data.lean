namespace AMW.Cert

theorem PS9_G_rev (x0 x1 x2 x3 x4 x5 x6 x7 : ℝ) : PS9.G x7 x6 x5 x4 x3 x2 x1 x0 = PS9.G x0 x1 x2 x3 x4 x5 x6 x7 := by
  unfold PS9.G; ring_nf

theorem PS9_half (y0 y1 y2 y3 y4 y5 y6 y7 : ℝ) (h0 : 0 ≤ y0) (h1 : 0 ≤ y1) (h2 : 0 ≤ y2) (h3 : 0 ≤ y3) (h4 : 0 ≤ y4) (h5 : 0 ≤ y5) (h6 : 0 ≤ y6) (h7 : 0 ≤ y7) :
    (PS9.cN : ℝ) / PS9.SA ≤ PS9.G y0 y1 y2 y3 y4 y5 y6 y7 ∨ y7 < y0 := by
  have hg : ∀ r < 8, 0 ≤ (fun r => [y0, y1, y2, y3, y4, y5, y6, y7].getD r 0) r := by
    intro r hr; interval_cases r <;> simpa
  rcases PS9Data.cert _ hg with h | h
  · left
    rw [PS9.Fg_G] at h
    rw [div_le_iff₀ (by norm_num [PS9.SA])]
    linarith
  · right; simpa using h

/-- **the AM 9-point certificate**: the half-space certificate completed by reflection (symmetric weights) -/
theorem PS9_cert_full : ∀ x0 x1 x2 x3 x4 x5 x6 x7 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 → 0 ≤ x5 → 0 ≤ x6 → 0 ≤ x7 →
    (PS9.cN : ℝ) / PS9.SA ≤ PS9.G x0 x1 x2 x3 x4 x5 x6 x7 := by
  intro x0 x1 x2 x3 x4 x5 x6 x7 h0 h1 h2 h3 h4 h5 h6 h7
  rcases lt_or_ge x7 x0 with hlt | hle
  · rcases PS9_half x7 x6 x5 x4 x3 x2 x1 x0 h7 h6 h5 h4 h3 h2 h1 h0 with h | h
    · rw [← PS9_G_rev]; exact h
    · exact absurd h (not_lt.mpr hlt.le)
  · rcases PS9_half x0 x1 x2 x3 x4 x5 x6 x7 h0 h1 h2 h3 h4 h5 h6 h7 with h | h
    · exact h
    · exact absurd h (not_lt.mpr hle)

