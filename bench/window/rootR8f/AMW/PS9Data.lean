  | _, _, _, _, i + 1, _, _, _, _, _, _, _, hi, _, _, _ => exact absurd hi (by omega)
  | _, _, _, _, _, i + 1, _, _, _, _, _, _, _, hi, _, _ => exact absurd hi (by omega)
  | _, _, _, _, _, _, i + 1, _, _, _, _, _, _, _, hi, _ => exact absurd hi (by omega)
