  | 0, 0, 0, 0, 0, 0, 0, 0, _, _, _, _, _, _, _, _ => exact rc0
  | i + 1, _, _, _, _, _, _, _, hi, _, _, _, _, _, _, _ => exact absurd hi (by omega)
  | _, i + 1, _, _, _, _, _, _, _, hi, _, _, _, _, _, _ => exact absurd hi (by omega)
  | _, _, i + 1, _, _, _, _, _, _, _, hi, _, _, _, _, _ => exact absurd hi (by omega)
