import AMW.PCellHG7

/-! ###### control for PCellHGT: bit 10,000 of the golden walk flipped; the decode no longer ends at 21,281.

(the golden-vector decode test of the canonical-Huffman walk (bridge-port; HUFF.md §8)

The whole root-15 walk of `huff_golden_g15.json` (R8 B440000, δ 0.1 %, LS 256; 21,280 bits, here shifted to start at bit 1)
on the root cell of its first node (every pair bound absent), decoded by the kernel walk of `PCellHG7` (the decode test:
every minorant leaf's check replaced by `true`; the tables of `huff_tables_g15.json`, the 5-bit lookup).  The walk ends at
bit 21,281 = 1 + 21,280: every node's tightening, split, reflection test, term code, `λ` field and multiplier entry
consumed exactly the encoder's bits (209 splits, 4 reflected, 185 minorant and 21 Farkas leaves; `amg/huffmirror.py` is
the same decode in Python, and it also matches the axis and bits of the 20 golden nodes), and the 21 Farkas leaves pass
the kernel's Farkas test with huffenc's multipliers.  Not a certificate. ###### -/

set_option maxRecDepth 100000

namespace AMW.Cert.PCellHGN

open AMW.Cert AMW.Cert.PCell AMW.Cert.PCellHG7

def BITS : ℕ := 

theorem flipped : U (walk 0 (fun _ => 0) 0 (fun _ => 0) (fun _ => 0) (0, 0, []) BITS 200 1)
    ⟨27648, 745472, 29184, 46592, 54272, 360448, 54784, 335872, 54272, 360448, 50688, 458752, 27648, 745472, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0⟩ ≠ 21281 := by
  decide +kernel

/-- bits 1758–1759 of the golden walk changed so that the Farkas leaf at bit 1751 (entries `c = 5, side 0, Yq = 1` and
`c = 10, side 1, Yq = 1`) reads `Yq = 2` on its first entry: the bit count is unchanged, the Farkas test fails, the walk
returns `0` -/
def BITSF : ℕ := 

theorem farkas_control : U (walk 0 (fun _ => 0) 0 (fun _ => 0) (fun _ => 0) (0, 0, []) BITSF 200 1)
    ⟨27648, 745472, 29184, 46592, 54272, 360448, 54784, 335872, 54272, 360448, 50688, 458752, 27648, 745472, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0, 1099511627776, 0⟩ = 0 := by
  decide +kernel

end AMW.Cert.PCellHGN
