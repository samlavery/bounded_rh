theorem toCl_ofCl (c : Cl) (m : ℕ) (h1 : c.L.length = 7) (h2 : c.U.length = 7) (h3 : c.A.length = 21) (h4 : c.B.length = 21) :
    toCl (ofCl c m) = c := by
  obtain ⟨L, U, A, B⟩ := c
  show Cl.mk _ _ _ _ = _
  congr 1
  exacts [list_of_getD L _ h1, list_of_getD U _ h2, list_of_getD A _ h3, list_of_getD B _ h4]

