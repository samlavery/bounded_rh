theorem run3 (i0 i1 i2 : ℕ) (h0 : i0 < 2) (h1 : i1 < 3) (h2 : i2 < 3) :
    Covered (rootCl 3 3 1099511627776 COV (fun r => [i0, i1, i2].getD r 0)) := by
  match i0, i1, i2, h0, h1, h2 with
  | 0, 0, 0, _, _, _ => exact rc0
  | 0, 0, 1, _, _, _ => exact rc1
  | 0, 0, 2, _, _, _ => exact rc2
  | 0, 1, 0, _, _, _ => exact rc3
  | 0, 1, 1, _, _, _ => exact rc4
  | 0, 1, 2, _, _, _ => exact rc5
  | 0, 2, 0, _, _, _ => exact rc6
  | 0, 2, 1, _, _, _ => exact rc7
  | 0, 2, 2, _, _, _ => exact rc8
  | 1, 0, 0, _, _, _ => exact rc9
  | 1, 0, 1, _, _, _ => exact rc10
  | 1, 0, 2, _, _, _ => exact rc11
  | 1, 1, 0, _, _, _ => exact rc12
  | 1, 1, 1, _, _, _ => exact rc13
  | 1, 1, 2, _, _, _ => exact rc14
  | 1, 2, 0, _, _, _ => exact rc15
  | 1, 2, 1, _, _, _ => exact rc16
  | 1, 2, 2, _, _, _ => exact rc17
  | i + 2, _, _, hi, _, _ => exact absurd hi (by omega)
  | _, i + 3, _, _, hi, _ => exact absurd hi (by omega)
  | _, _, i + 3, _, _, hi => exact absurd hi (by omega)

theorem run : ∀ idx : ℕ → ℕ, (∀ r < 3, idx r < (badOf (COV.getD r [])).length) → Covered (rootCl 3 3 1099511627776 COV idx) := by
  intro idx h
  rw [rootCl_congr (idx' := fun r => [idx 0, idx 1, idx 2].getD r 0) (fun r hr => by interval_cases r <;> rfl)]
  have l0 : (badOf (COV.getD 0 [])).length = 2 := rfl
  have l1 : (badOf (COV.getD 1 [])).length = 3 := rfl
  have l2 : (badOf (COV.getD 2 [])).length = 3 := rfl
  exact run3 _ _ _ (l0 ▸ h 0 (by norm_num)) (l1 ▸ h 1 (by norm_num)) (l2 ▸ h 2 (by norm_num))

/-- the certificate on every point with nonnegative gaps (no reflection: the truncated functional has no mirror symmetry) -/
theorem cert : ∀ g : ℕ → ℝ, (∀ r < 3, 0 ≤ g r) → PgL cN 3 BS TS g :=
  cert_of COV SMAX (by decide) (by decide +kernel) (by decide) 1099511627776 (by decide) run

