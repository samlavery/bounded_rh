noncomputable section

namespace AMW.Cert

/-- **the truncated-window certificate** on every point with nonnegative gaps -/
theorem PCE3_cert_full : ∀ x0 x1 x2 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 →
    (PCE3.cN : ℝ) / PCE3.SA ≤ PCE3.G x0 x1 x2 := by
  intro x0 x1 x2 h0 h1 h2
  have hg : ∀ r < 3, 0 ≤ (fun r => [x0, x1, x2].getD r 0) r := by
    intro r hr; interval_cases r <;> simpa
  have h := PCE3Data.cert _ hg
  simp only [AMW.Cert.PCell.PgL] at h
  rw [PCE3.Fg_G] at h
  rw [div_le_iff₀ (by norm_num [PCE3.SA])]
  linarith

end AMW.Cert

