/-- the pyramid read with a coarser cover (cells of `(hi − lo)/2^3..2^4`) -/
def lbK (top : ℕ) (bk : ℕ → ℕ) (lo hi : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ)
    (Bool.rec (motive := fun _ => ℕ)
      (let k := blen (Nat.shiftRight (Nat.sub hi lo) 3)
       dcov top bk k (Nat.shiftRight (Nat.sub hi 1) k) (Nat.shiftRight lo k))
      0 (Nat.ble 524289 hi))
    0 (Nat.ble hi lo)

/-- the accumulator of a minorant leaf: side conditions so far, offset, and mscheck's sums so far -/
structure MA where
  (ok : Bool) (o Am Ap B W0 W1 W2 W3 W4 W5 W6 S0 S1 S2 S3 S4 S5 S6 : ℕ)

/-- evaluate a natural before continuing with an accumulator (the kernel is call-by-name) -/
def forceM (a : ℕ) (k : ℕ → MA) : MA := Nat.rec (motive := fun _ => MA) (k 0) (fun n _ => k (Nat.succ n)) a

theorem forceM_eq (a : ℕ) (k : ℕ → MA) : forceM a k = k a := by cases a <;> rfl

