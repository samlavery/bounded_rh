theorem PS8_G_rev (x0 x1 x2 x3 x4 x5 x6 : ℝ) : PS8.G x6 x5 x4 x3 x2 x1 x0 = PS8.G x0 x1 x2 x3 x4 x5 x6 := by
  unfold PS8.G; ring_nf

theorem PS8_half (y0 y1 y2 y3 y4 y5 y6 : ℝ) (h0 : 0 ≤ y0) (h1 : 0 ≤ y1) (h2 : 0 ≤ y2) (h3 : 0 ≤ y3) (h4 : 0 ≤ y4) (h5 : 0 ≤ y5) (h6 : 0 ≤ y6) :
    (PS8.cN : ℝ) / PS8.SA ≤ PS8.G y0 y1 y2 y3 y4 y5 y6 ∨ y6 < y0 := by
  have hg : ∀ r < 7, 0 ≤ (fun r => [y0, y1, y2, y3, y4, y5, y6].getD r 0) r := by
    intro r hr; interval_cases r <;> simpa
  rcases PS8Data.cert _ hg with h | h
  · left
    rw [PS8.Fg_G] at h
    rw [div_le_iff₀ (by norm_num [PS8.SA])]
    linarith
  · right; simpa using h

/-- **the AM 8-point certificate**: the half-space certificate completed by reflection (symmetric weights) -/
theorem PS8_cert_full : ∀ x0 x1 x2 x3 x4 x5 x6 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 → 0 ≤ x5 → 0 ≤ x6 →
    (PS8.cN : ℝ) / PS8.SA ≤ PS8.G x0 x1 x2 x3 x4 x5 x6 := by
  intro x0 x1 x2 x3 x4 x5 x6 h0 h1 h2 h3 h4 h5 h6
  rcases lt_or_ge x6 x0 with hlt | hle
  · rcases PS8_half x6 x5 x4 x3 x2 x1 x0 h6 h5 h4 h3 h2 h1 h0 with h | h
    · rw [← PS8_G_rev]; exact h
    · exact absurd h (not_lt.mpr hlt.le)
  · rcases PS8_half x0 x1 x2 x3 x4 x5 x6 h0 h1 h2 h3 h4 h5 h6 with h | h
    · exact h
    · exact absurd h (not_lt.mpr hle)

end AMW.Cert

