  | 0, 0, 0, 0, 0, 0, 0, _, _, _, _, _, _, _ => exact rc0
  | i + 1, _, _, _, _, _, _, hi, _, _, _, _, _, _ => exact absurd hi (by omega)
  | _, i + 1, _, _, _, _, _, _, hi, _, _, _, _, _ => exact absurd hi (by omega)
  | _, _, i + 1, _, _, _, _, _, _, hi, _, _, _, _ => exact absurd hi (by omega)
  | _, _, _, i + 1, _, _, _, _, _, _, hi, _, _, _ => exact absurd hi (by omega)
  | _, _, _, _, i + 1, _, _, _, _, _, _, hi, _, _ => exact absurd hi (by omega)
  | _, _, _, _, _, i + 1, _, _, _, _, _, _, hi, _ => exact absurd hi (by omega)
  | _, _, _, _, _, _, i + 1, _, _, _, _, _, _, hi => exact absurd hi (by omega)

theorem run : ∀ idx : ℕ → ℕ, (∀ r < 7, idx r < (badOf (COV.getD r [])).length) → Covered (rootCl 7 21 1099511627776 COV idx) := by
  intro idx h
