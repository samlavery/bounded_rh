  have l0 : (badOf (COV.getD 0 [])).length = 1 := rfl
  have l1 : (badOf (COV.getD 1 [])).length = 1 := rfl
  have l2 : (badOf (COV.getD 2 [])).length = 1 := rfl
  have l3 : (badOf (COV.getD 3 [])).length = 1 := rfl
  have l4 : (badOf (COV.getD 4 [])).length = 1 := rfl
  have l5 : (badOf (COV.getD 5 [])).length = 1 := rfl
  have l6 : (badOf (COV.getD 6 [])).length = 1 := rfl
  exact run7 _ _ _ _ _ _ _ (l0 ▸ h 0 (by norm_num)) (l1 ▸ h 1 (by norm_num)) (l2 ▸ h 2 (by norm_num)) (l3 ▸ h 3 (by norm_num)) (l4 ▸ h 4 (by norm_num)) (l5 ▸ h 5 (by norm_num)) (l6 ▸ h 6 (by norm_num))

