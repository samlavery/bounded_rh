namespace AMW.Cert

/-- **the truncated-window certificate** on every point with nonnegative gaps -/
theorem PCE4G_cert_full : ∀ x0 x1 x2 x3 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 →
    (PCE4G.cN : ℝ) / PCE4G.SA ≤ PCE4G.G x0 x1 x2 x3 := by
  intro x0 x1 x2 x3 h0 h1 h2 h3
  have hg : ∀ r < 4, 0 ≤ (fun r => [x0, x1, x2, x3].getD r 0) r := by
    intro r hr; interval_cases r <;> simpa
  have h := PCE4GData.cert _ hg
  simp only [AMW.Cert.PCell.PgL] at h
  rw [PCE4G.Fg_G] at h
  rw [div_le_iff₀ (by norm_num [PCE4G.SA])]
  linarith

end AMW.Cert

