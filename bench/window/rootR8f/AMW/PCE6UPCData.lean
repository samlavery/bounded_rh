/-- the point function: an added point, else `PC8C5BFData`'s table (the triples both tables hold are identical) -/
def PT (x : ℕ) : ℕ := forceR (PTN x) fun v => Bool.rec (motive := fun _ => ℕ) v (AMW.Cert.PC8C5BFData.PT x) (Nat.beq v 0)
theorem ptS : PTF PT := fun x => by
  unfold PT; rw [forceR_eq]
  cases Nat.beq (PTN x) 0
  · exact PTN_ok x
  · exact AMW.Cert.PC8C5BFData.ptS x

