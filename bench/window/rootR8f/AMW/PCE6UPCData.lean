theorem run : ∀ idx : ℕ → ℕ, (∀ r < 6, idx r < (badOf (COV.getD r [])).length) → Covered (rootCl 6 15 1099511627776 COV idx) := by
  intro idx h
  rw [rootCl_congr (idx' := fun r => [idx 0, idx 1, idx 2, idx 3, idx 4, idx 5].getD r 0) (fun r hr => by interval_cases r <;> rfl)]
  have l0 : (badOf (COV.getD 0 [])).length = 1 := rfl
  have l1 : (badOf (COV.getD 1 [])).length = 2 := rfl
  have l2 : (badOf (COV.getD 2 [])).length = 2 := rfl
  have l3 : (badOf (COV.getD 3 [])).length = 2 := rfl
  have l4 : (badOf (COV.getD 4 [])).length = 2 := rfl
  have l5 : (badOf (COV.getD 5 [])).length = 2 := rfl
  exact run6 _ _ _ _ _ _ (l0 ▸ h 0 (by norm_num)) (l1 ▸ h 1 (by norm_num)) (l2 ▸ h 2 (by norm_num)) (l3 ▸ h 3 (by norm_num)) (l4 ▸ h 4 (by norm_num)) (l5 ▸ h 5 (by norm_num))

/-- the certificate on every point with nonnegative gaps (no reflection: the truncated functional has no mirror symmetry) -/
theorem cert : ∀ g : ℕ → ℝ, (∀ r < 6, 0 ≤ g r) → PgL cN 6 BS TS g :=
  cert_of COV SMAX (by decide) (by decide +kernel) (by decide) 1099511627776 (by decide) run

