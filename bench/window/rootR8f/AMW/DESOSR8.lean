import AMW.DECertSOS
import AMW.DEData

/-! ###### AMW/DESOSR8 — `certC cR8 ≥ 0` on ℝ by an integer Fejér–Riesz certificate (am-cert)

The factor `a_j = AL[j]/DC` (`DC = 10^16`) is the minimum-phase Fejér–Riesz factor of `C − 4866239/500000000000`
(cepstral method on 2^20 points, `bench/window/desos/desos_fact.py`), rounded. The exact check (`9216` integer
products) gives `certC cR8 ≥ m_C = MZ/(E·DC²) = 9.732478e-06`. ###### -/

noncomputable section

open Finset

namespace AMW.DE

namespace SOSR8

def AL : List ℤ := [553462501055539, 935201296933816, 1074184703548369, 1261956882482608, 1392841874719249, 1459494668505164, 1608568577602253, 1738057443564465, 1794929270681636, 1908015731762262, 2003465170661529, 1919543514646946, 1915065687302188, 2023684936976515, 2088214344099042, 1988384650215850, 1923423367597831, 1847874837842319, 1796801573606212, 1819297696901594, 1864905696954264, 1832417656841324, 1802481112918217, 1805526441636596, 1774317351565374, 1739664281323724, 1736977900864058, 1719916384868671, 1766668951900014, 1759626899406993, 1824945185689339, 1913021953984618, 1189951292632124, 623336210572065, 437145050218861, 189031220068987, 38765905504410, 20324305064936, -25358877933537, -14019665480610, -28464714359252, -106814360803673, -182398514897210, 14304521610163, 67889094650562, -82036896399092, -251641570194222, -170950942192055, -79656887231310, -18017437494545, 57411319932419, 46639720431562, -8937380046644, 20208712492658, 42061401154408, 10929907251376, 13064845985327, 55707454349642, -2232310328519, -5738768434495, -79910261771751, -40225138150088, -85266836050167, -251215760836900, -55309477051706, 122981397017594, 162510641868607, 222886725099738, 239044127608109, 191006064036213, 108307543604645, -11004987742380, -37479651053950, -47939210558439, -54763313079666, -161909992028340, -203186990875317, -143808773944947, -26332749644554, 7040658522797, -5122190835634, 14977405986865, -2057663131431, -12098585810155, 238856020063, -1642371749145, -4269248001333, -992163795572, 6863735072009, -21177514046670, 12599230870256, 21354265454982, 43752755363127, -10407383210022, -43657942340579, -1]
def AC (j : ℕ) : ℤ := AL.getD j 0
def DC : ℕ := 10000000000000000
def MZC : ℤ := 1070097270470887175182323053797184634880

theorem AC_zero : ∀ j, cR8.n ≤ j → AC j = 0 := by
  intro j hj
  unfold AC
  exact List.getD_eq_default _ _ (by simpa [AL, cR8, PLCert.n] using hj)

/-- **the certificate check** -/
theorem chk : MZC ≤ AMW.DESOS.resZ cR8.Y AC cR8.E DC cR8.n 0
    - 2 * ∑ k ∈ Ico 1 cR8.n, |AMW.DESOS.resZ cR8.Y AC cR8.E DC cR8.n k| := by
  decide +kernel

end SOSR8

/-- **`certC cR8 ≥ 0` on ℝ** (obligation G) -/
theorem certG_R8 : CertGNonneg cR8 :=
  certG_of_int cR8 SOSR8.AC SOSR8.DC (by decide) (by norm_num [SOSR8.DC]) SOSR8.AC_zero SOSR8.MZC
    (by decide) SOSR8.chk

/-- the integer form of the slack `ĝ(0) − g(0)` -/
theorem chkS_R8 : cR8.Y 0 * (cR8.DkInv : ℤ) - (cR8.Y 0 + 2 * ∑ k ∈ Ico 1 cR8.n, cR8.Y k)
    = 48094915444 := by
  decide +kernel

/-- **the exact slack** `ĝ(0) − g(0) = y₀ − Dk · certC cR8 0 = 12023728861/8796093022208` -/
theorem ghat0_sub_g0_R8 : cR8.y 0 - cR8.dk * certC cR8 0 = (12023728861 : ℝ) / 8796093022208 := by
  rw [ghat0_sub_g0_of_int cR8 (by decide) (by decide) 48094915444 chkS_R8]
  simp only [cR8]
  norm_num

end AMW.DE

