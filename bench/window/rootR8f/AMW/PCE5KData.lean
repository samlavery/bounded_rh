/-- **the truncated-window certificate** on every point with nonnegative gaps -/
theorem PCE5K_cert_full : ∀ x0 x1 x2 x3 x4 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 →
    (PCE5K.cN : ℝ) / PCE5K.SA ≤ PCE5K.G x0 x1 x2 x3 x4 := by
  intro x0 x1 x2 x3 x4 h0 h1 h2 h3 h4
  have hg : ∀ r < 5, 0 ≤ (fun r => [x0, x1, x2, x3, x4].getD r 0) r := by
    intro r hr; interval_cases r <;> simpa
  have h := PCE5KData.cert _ hg
  simp only [AMW.Cert.PCell.PgL] at h
  rw [PCE5K.Fg_G] at h
  rw [div_le_iff₀ (by norm_num [PCE5K.SA])]
  linarith

