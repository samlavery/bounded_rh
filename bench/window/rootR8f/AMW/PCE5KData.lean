theorem run5 (i0 i1 i2 i3 i4 : ℕ) (h0 : i0 < 1) (h1 : i1 < 2) (h2 : i2 < 2) (h3 : i3 < 2) (h4 : i4 < 2) :
    Covered (rootCl 5 10 1099511627776 COV (fun r => [i0, i1, i2, i3, i4].getD r 0)) := by
  match i0, i1, i2, i3, i4, h0, h1, h2, h3, h4 with
  | 0, 0, 0, 0, 0, _, _, _, _, _ => exact rc0
  | 0, 0, 0, 0, 1, _, _, _, _, _ => exact rc1
  | 0, 0, 0, 1, 0, _, _, _, _, _ => exact rc2
  | 0, 0, 0, 1, 1, _, _, _, _, _ => exact rc3
  | 0, 0, 1, 0, 0, _, _, _, _, _ => exact rc4
  | 0, 0, 1, 0, 1, _, _, _, _, _ => exact rc5
  | 0, 0, 1, 1, 0, _, _, _, _, _ => exact rc6
  | 0, 0, 1, 1, 1, _, _, _, _, _ => exact rc7
  | 0, 1, 0, 0, 0, _, _, _, _, _ => exact rc8
  | 0, 1, 0, 0, 1, _, _, _, _, _ => exact rc9
  | 0, 1, 0, 1, 0, _, _, _, _, _ => exact rc10
  | 0, 1, 0, 1, 1, _, _, _, _, _ => exact rc11
  | 0, 1, 1, 0, 0, _, _, _, _, _ => exact rc12
  | 0, 1, 1, 0, 1, _, _, _, _, _ => exact rc13
  | 0, 1, 1, 1, 0, _, _, _, _, _ => exact rc14
  | 0, 1, 1, 1, 1, _, _, _, _, _ => exact rc15
  | i + 1, _, _, _, _, hi, _, _, _, _ => exact absurd hi (by omega)
  | _, i + 2, _, _, _, _, hi, _, _, _ => exact absurd hi (by omega)
  | _, _, i + 2, _, _, _, _, hi, _, _ => exact absurd hi (by omega)
  | _, _, _, i + 2, _, _, _, _, hi, _ => exact absurd hi (by omega)
  | _, _, _, _, i + 2, _, _, _, _, hi => exact absurd hi (by omega)

theorem run : ∀ idx : ℕ → ℕ, (∀ r < 5, idx r < (badOf (COV.getD r [])).length) → Covered (rootCl 5 10 1099511627776 COV idx) := by
  intro idx h
  rw [rootCl_congr (idx' := fun r => [idx 0, idx 1, idx 2, idx 3, idx 4].getD r 0) (fun r hr => by interval_cases r <;> rfl)]
  have l0 : (badOf (COV.getD 0 [])).length = 1 := rfl
  have l1 : (badOf (COV.getD 1 [])).length = 2 := rfl
  have l2 : (badOf (COV.getD 2 [])).length = 2 := rfl
  have l3 : (badOf (COV.getD 3 [])).length = 2 := rfl
  have l4 : (badOf (COV.getD 4 [])).length = 2 := rfl
  exact run5 _ _ _ _ _ (l0 ▸ h 0 (by norm_num)) (l1 ▸ h 1 (by norm_num)) (l2 ▸ h 2 (by norm_num)) (l3 ▸ h 3 (by norm_num)) (l4 ▸ h 4 (by norm_num))

/-- the certificate on every point with nonnegative gaps (no reflection: the truncated functional has no mirror symmetry) -/
theorem cert : ∀ g : ℕ → ℝ, (∀ r < 5, 0 ≤ g r) → PgL cN 5 BS TS g :=
  cert_of COV SMAX (by decide) (by decide +kernel) (by decide) 1099511627776 (by decide) run

