theorem mcheckP_ok {top : ℕ} {bk : ℕ → ℕ} {tD : ℕ} {bD : ℕ → ℕ} {f : ℕ → ℕ} {R : ℕ × ℕ × List (List ℕ)} (s : St)
    (k01 m01 p01 r01 k02 m02 p02 r02 k03 m03 p03 r03 k12 m12 p12 r12 k13 m13 p13 r13 k23 m23 p23 r23 : ℕ) (P0 P1 P2 S0 S1 S2 Cp Cm : ℕ) (h : mcheckP top bk tD bD f R s k01 m01 p01 r01 k02 m02 p02 r02 k03 m03 p03 r03 k12 m12 p12 r12 k13 m13 p13 r13 k23 m23 p23 r23 P0 P1 P2 S0 S1 S2 Cp Cm = true) :
    mcheckG top bk tD bD f R 3 BS TS cN (toCl s) [(k01, m01, p01, r01), (k02, m02, p02, r02), (k03, m03, p03, r03), (k12, m12, p12, r12), (k13, m13, p13, r13), (k23, m23, p23, r23)]
      [P0, P1, P2] [S0, S1, S2] Cp Cm = true := by
  simp only [mcheckP, mvK_eq, mcpK_eq, mcnK_eq, mslK_eq] at h; exact h

/-- the polytope minorant leaf: the payload length when the check passes, else `0` -/
def mleafP (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (w : ℕ) (s : St) : ℕ :=
  forceR (nmax s.A02 (Nat.add s.l0 s.l1)) fun L02 => forceR (nmin s.B02 (Nat.add s.u0 s.u1)) fun U02 =>
  forceR (nmax s.A03 (Nat.add (Nat.add s.l0 s.l1) s.l2)) fun L03 => forceR (nmin s.B03 (Nat.add (Nat.add s.u0 s.u1) s.u2)) fun U03 =>
  forceR (nmax s.A13 (Nat.add s.l1 s.l2)) fun L13 => forceR (nmin s.B13 (Nat.add s.u1 s.u2)) fun U13 =>
  forceR 0 fun o0 =>
  dec4K w o0 s.l0 s.u0 fun k01 m01 p01 r01 o1 =>
  dec4K w o1 L02 U02 fun k02 m02 p02 r02 o2 =>
  dec4K w o2 L03 U03 fun k03 m03 p03 r03 o3 =>
  dec4K w o3 s.l1 s.u1 fun k12 m12 p12 r12 o4 =>
  dec4K w o4 L13 U13 fun k13 m13 p13 r13 o5 =>
  dec4K w o5 s.l2 s.u2 fun k23 m23 p23 r23 o6 =>
  (fun y : YA => Bool.rec (motive := fun _ => ℕ) 0 y.o (mcheckP top bk tD bD (pt3 pb) R s k01 m01 p01 r01 k02 m02 p02 r02 k03 m03 p03 r03 k12 m12 p12 r12 k13 m13 p13 r13 k23 m23 p23 r23 y.P0 y.P1 y.P2 y.S0 y.S1 y.S2 y.Cp y.Cm))
  (ydec (toCl s).L (toCl s).A (toCl s).B w 8 ⟨o6, 0, 0, 0, 0, 0, 0, 0, 0⟩)

theorem mleafP_ok {top : ℕ} {bk : ℕ → ℕ} {tD : ℕ} {bD : ℕ → ℕ} {pb : ℕ → ℕ} {R : ℕ × ℕ × List (List ℕ)}
    (hlb : LBSound top bk) (hD : LBSoundD tD bD) (hpt : PT3Sound pb) (hR : rgOk R = true) (w : ℕ) (s : St)
    (h : mleafP top bk tD bD pb R w s ≠ 0) : Covered (toCl s) := by
  unfold mleafP at h
  simp only [dec4K, forceR_eq] at h
  exact mcheckG_sound (f := pt3 pb) hlb hD hpt hR hPR hTS (ydec_ok s w 8 _ (MulOK_zero s _)) (mcheckP_ok _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (brec_ne h))

/-- (kind 8) the Farkas leaf: the multiplier list only, accepted when the multiplier form is negative on the whole box -/
def fleaf (w : ℕ) (s : St) : ℕ :=
  (fun y : YA => Bool.rec (motive := fun _ => ℕ) 0 y.o
    (Nat.blt (Nat.add y.Cp (fsum (toCl s) [y.P0, y.P1, y.P2] [y.S0, y.S1, y.S2] 3)) y.Cm))
  (ydec (toCl s).L (toCl s).A (toCl s).B w 8 ⟨0, 0, 0, 0, 0, 0, 0, 0, 0⟩)

theorem fleaf_ok (w : ℕ) (s : St) (h : fleaf w s ≠ 0) : Covered (toCl s) :=
  farkas_cov (ydec_ok s w 8 _ (MulOK_zero s 0)) (brec_ne h)

/-- a leaf (bit 0 clear): the reflected half-space (`u2 < l0`, no further bits), else bit 1 the kind (minorant leaf, or
Farkas leaf) with its payload from bit 2 -/
def leafStep (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (pos w : ℕ) : ST :=
  fun l0 u0 l1 u1 l2 u2 A02 B02 A03 B03 A13 B13 M => Bool.rec (motive := fun _ => ℕ)
    (forceR (Bool.rec (motive := fun _ => ℕ) (mleafP top bk tD bD pb R (Nat.shiftRight w 2) ⟨l0, u0, l1, u1, l2, u2, A02, B02, A03, B03, A13, B13, M⟩)
        (fleaf (Nat.shiftRight w 2) ⟨l0, u0, l1, u1, l2, u2, A02, B02, A03, B03, A13, B13, M⟩) (Nat.beq (Nat.land (Nat.shiftRight w 1) 1) 1)) fun n =>
      Bool.rec (motive := fun _ => ℕ) (Nat.add pos (Nat.add 2 n)) 0 (Nat.beq n 0))
    (Nat.add pos 1) (Nat.blt u2 l0)

theorem leafStep_ok {top : ℕ} {bk : ℕ → ℕ} {tD : ℕ} {bD : ℕ → ℕ} {pb : ℕ → ℕ} {R : ℕ × ℕ × List (List ℕ)}
    (hlb : LBSound top bk) (hD : LBSoundD tD bD) (hpt : PT3Sound pb) (hR : rgOk R = true) (pos w : ℕ) :
    CovK (leafStep top bk tD bD pb R pos w) := by
  intro s h
  have h' : Bool.rec (motive := fun _ => ℕ) (forceR (Bool.rec (motive := fun _ => ℕ) (mleafP top bk tD bD pb R (Nat.shiftRight w 2) s)
      (fleaf (Nat.shiftRight w 2) s) (Nat.beq (Nat.land (Nat.shiftRight w 1) 1) 1)) fun n =>
      Bool.rec (motive := fun _ => ℕ) (Nat.add pos (Nat.add 2 n)) 0 (Nat.beq n 0)) (Nat.add pos 1) (Nat.blt s.u2 s.l0) ≠ 0 := h
  cases hs : Nat.blt s.u2 s.l0
  · rw [hs, forceR_eq] at h'
    cases hk : Nat.beq (Nat.land (Nat.shiftRight w 1) 1) 1
    · rw [hk] at h'; exact mleafP_ok hlb hD hpt hR _ s fun h0 => by rw [h0] at h'; exact h' rfl
    · rw [hk] at h'; exact fleaf_ok _ s fun h0 => by rw [h0] at h'; exact h' rfl
  · intro g hg
    right
    have h1 : g 2 ≤ (s.u2 : ℝ) / SC := (hg.1 2 (by norm_num)).2
    have h2 : (s.l0 : ℝ) / SC ≤ g 0 := (hg.1 0 (by norm_num)).1
    have : (s.u2 : ℝ) / SC < (s.l0 : ℝ) / SC := div_lt_div_of_pos_right (by exact_mod_cast Nat.blt_eq.mp hs) SC_pos
    show g 2 < g 0
    linarith

/-- a node: bit 0 of `bits >>> pos` selects split (axis in bits 1..3) or leaf -/
def node (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (bits : ℕ) (ih : WF) (pos : ℕ) : ST :=
  Bool.rec (motive := fun _ => ST) (leafStep top bk tD bD pb R pos (Nat.shiftRight bits pos))
    (splitAx ih pos (Nat.land (Nat.shiftRight (Nat.shiftRight bits pos) 1) 7)) (Nat.beq (Nat.land (Nat.shiftRight bits pos) 1) 1)

/-- the walk: every node is first tightened (an empty node ends there, no bits) -/
def walk (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (bits fuel : ℕ) : WF :=
  Nat.rec (motive := fun _ => WF) (fun _ => zK) (fun _ ih pos => fbN pos (node top bk tD bD pb R bits ih pos)) fuel

theorem walk_ok {top : ℕ} {bk : ℕ → ℕ} {tD : ℕ} {bD : ℕ → ℕ} {pb : ℕ → ℕ} {R : ℕ × ℕ × List (List ℕ)}
    (hlb : LBSound top bk) (hD : LBSoundD tD bD) (hpt : PT3Sound pb) (hR : rgOk R = true) (bits : ℕ) :
    ∀ fuel, WalkOK (walk top bk tD bD pb R bits fuel)
  | 0 => fun _ => zK_ok
  | n + 1 => fun pos => fbN_ok (brec_dep (fun _ => leafStep_ok hlb hD hpt hR pos _) fun _ =>
      splitAx_ok (walk_ok hlb hD hpt hR bits n) pos _)

theorem covered_of_walk {top : ℕ} {bk : ℕ → ℕ} {tD : ℕ} {bD : ℕ → ℕ} {pb : ℕ → ℕ} {R : ℕ × ℕ × List (List ℕ)}
    (hlb : LBSound top bk) (hD : LBSoundD tD bD) (hpt : PT3Sound pb) (hR : rgOk R = true) (bits fuel e : ℕ) (s : St)
    (h : U (walk top bk tD bD pb R bits fuel 1) s = e) (he : e ≠ 0) : Covered (toCl s) :=
  walk_ok hlb hD hpt hR bits fuel 1 s (h ▸ he)

/-- the adjacent term of each gap (its index in `TS`) -/
def ADJ : List ℕ := [0, 3, 5]
theorem hADJ : ∀ r < 3, ADJ.getD r 0 < TS.length ∧ tI TS (ADJ.getD r 0) = r ∧ tJ TS (ADJ.getD r 0) = r + 1 := by decide

/-- (root) the certificate on every point with nonnegative gaps, from the per-gap covers (`coverChk`) and the walks over
the root cells (`rootCl`: a bad segment per gap, pair bounds absent) -/
theorem cert_of (cov : List (List (ℕ × ℕ × Bool))) (Smax : ℕ → ℕ) (hS : ∀ r < 3, cN * SC ≤ BS.getD r 0 * Smax r)
    (hcov : ∀ r < 3, coverChk cN (tA TS (ADJ.getD r 0)) (SC / 2) (Smax r) (cov.getD r []) = true)
    (hwin : ∀ r < 3, cN * 4 ≤ tA TS (ADJ.getD r 0)) (W : ℕ) (hW : 3 * KB ≤ W)
    (hrun : ∀ idx : ℕ → ℕ, (∀ r < 3, idx r < (badOf (cov.getD r [])).length) → Covered (rootCl 3 3 W cov idx)) :
    ∀ g : ℕ → ℝ, (∀ r < 3, 0 ≤ g r) → Pg cN 3 BS TS g :=
  root_cover hPR (fun r => ADJ.getD r 0) hADJ Smax hS cov hcov hwin W hW hrun

/-- the root: every pair bound absent (`A = 0`, `B = W ≥ Σ u`) -/
theorem covered_box (s : St) (W : ℕ) (hA : ∀ k < 3, (toCl s).A.getD k 0 = 0) (hB : ∀ k < 3, (toCl s).B.getD k 0 = W)
    (hW : sumR (toCl s).U 0 3 ≤ W) (h : Covered (toCl s)) (g : ℕ → ℝ) (hb : InBox 3 (toCl s) g) : Pg cN 3 BS TS g :=
  h g (incell_root hPR hA hB hW hb)


