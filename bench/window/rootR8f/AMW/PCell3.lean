import AMW.PCellRoot

/-! ###### polytope cells for Q = 3: the instance layer (bridge-port, generated by amg/genpcell2.py)

Kernel functions unrolled on the curried state (6 gap and 6 pair bounds); every proof is a link to the generic
layer `AMW.PCellGen` through `toCl : St → Cl`.  Engine, tables and per-term minorants: mvt-engine's MinCore on the AM
engine (pyramid oracle adapted from five-point-pyramid-2 by typh, convex basins after six-point-convex-basins-2 by typh,
Apache-2.0). ###### -/

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

noncomputable section

namespace AMW.Cert.PCell3

open AMW.Cert AMW.Cert.Pyr AMW.Cert.PyrD AMW.Cert.PCell

def cN : ℕ := 550000
/-- the multiplier quantum: `Y = SIG · Yq`, `Yq < 2^12` (`2^-14` per unit g) -/
def SIG : ℕ := 6250000000000000

/-- the non-adjacent pairs, in pair order -/
def PR : List (ℕ × ℕ) := [(0, 2), (0, 3), (1, 3)]
theorem hPR : PRok 3 PR := by decide
/-- the gap weights and the terms `(i, j, a, k)` of the functional `Fg` (units 1/SA) -/
def BS : List ℕ := [31833, 58928, 31833]
def TS : List Term := [(0, 1, 16291486, 0), (0, 2, 59631729, 0), (0, 3, 100000000, 1), (1, 2, 32082429, 0), (1, 3, 59631729, 2), (2, 3, 16291486, 0)]
theorem hTS : TSok 3 PR TS := by decide

abbrev Covered : Cl → Prop := CovBy 3 PR (Pg cN 3 BS TS)

/-- the kernel state -/
structure St where
  (l0 u0 l1 u1 l2 u2 A02 B02 A03 B03 A13 B13 M : ℕ)

def toCl (s : St) : Cl :=
  ⟨[s.l0, s.l1, s.l2], [s.u0, s.u1, s.u2],
   [s.A02, s.A03, s.A13], [s.B02, s.B03, s.B13]⟩
def ofCl (c : Cl) (m : ℕ) : St :=
  ⟨c.L.getD 0 0, c.U.getD 0 0, c.L.getD 1 0, c.U.getD 1 0, c.L.getD 2 0, c.U.getD 2 0, c.A.getD 0 0, c.B.getD 0 0, c.A.getD 1 0, c.B.getD 1 0, c.A.getD 2 0, c.B.getD 2 0, m⟩

theorem toCl_ofCl (c : Cl) (m : ℕ) (h1 : c.L.length = 3) (h2 : c.U.length = 3) (h3 : c.A.length = 3) (h4 : c.B.length = 3) :
    toCl (ofCl c m) = c := by
  obtain ⟨L, U, A, B⟩ := c
  show Cl.mk _ _ _ _ = _
  congr 1
  exacts [list_of_getD L _ h1, list_of_getD U _ h2, list_of_getD A _ h3, list_of_getD B _ h4]

abbrev ST : Type := ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ
/-- a continuation applied to a state -/
def U (k : ST) (s : St) : ℕ := k s.l0 s.u0 s.l1 s.u1 s.l2 s.u2 s.A02 s.B02 s.A03 s.B03 s.A13 s.B13 s.M
def CovK (k : ST) : Prop := ∀ s, U k s ≠ 0 → Covered (toCl s)
abbrev WF : Type := ℕ → ST
def WalkOK (f : WF) : Prop := ∀ pos, CovK (f pos)
def zK : ST := fun _ _ _ _ _ _ _ _ _ _ _ _ _ => 0
theorem zK_ok : CovK zK := fun _ h => absurd rfl h

theorem ofCl_ok {k : ST} (hk : CovK k) {c : Cl} {m : ℕ} (h1 : c.L.length = 3) (h2 : c.U.length = 3) (h3 : c.A.length = 3)
    (h4 : c.B.length = 3) (h : U k (ofCl c m) ≠ 0) : Covered c :=
  toCl_ofCl c m h1 h2 h3 h4 ▸ hk _ h

/-- a split node's two children (`cA` from `pos + 4`, then `cB`) cover the cell when the split lemma does -/
theorem sp_ok {ih : WF} (hih : WalkOK ih) {s : St} {cA cB : Cl} {pos mA mB : ℕ}
    (hc : Covered cA → Covered cB → Covered (toCl s))
    (h : Bool.rec (motive := fun _ => ℕ) (U (ih (U (ih (Nat.add pos 4)) (ofCl cA mA))) (ofCl cB mB)) 0
      (Nat.beq (U (ih (Nat.add pos 4)) (ofCl cA mA)) 0) ≠ 0)
    (hA : cA.L.length = 3 ∧ cA.U.length = 3 ∧ cA.A.length = 3 ∧ cA.B.length = 3)
    (hB : cB.L.length = 3 ∧ cB.U.length = 3 ∧ cB.A.length = 3 ∧ cB.B.length = 3) : Covered (toCl s) := by
  cases hp : Nat.beq (U (ih (Nat.add pos 4)) (ofCl cA mA)) 0
  · rw [hp] at h
    exact hc (ofCl_ok (hih _) hA.1 hA.2.1 hA.2.2.1 hA.2.2.2 fun h0 => by rw [h0] at hp; exact absurd hp (by decide))
      (ofCl_ok (hih _) hB.1 hB.2.1 hB.2.2.1 hB.2.2.2 h)
  · rw [hp] at h; exact absurd rfl h


-- (2) split nodes: gap r at the midpoint of [l_r, u_r]; pair t at the midpoint of its effective range

def gsplit0 (ih : WF) (pos a b c d e f g h i j l m n : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add a b) 1) fun q => let p := ih (Nat.add pos 4) a q c d e f g h i j l m n
  Bool.rec (motive := fun _ => ℕ) (ih p q b c d e f g h i j l m n) 0 (Nat.beq p 0)

def gsplit1 (ih : WF) (pos a b c d e f g h i j l m n : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add c d) 1) fun q => let p := ih (Nat.add pos 4) a b c q e f g h i j l m n
  Bool.rec (motive := fun _ => ℕ) (ih p a b q d e f g h i j l m n) 0 (Nat.beq p 0)

def gsplit2 (ih : WF) (pos a b c d e f g h i j l m n : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add e f) 1) fun q => let p := ih (Nat.add pos 4) a b c d e q g h i j l m n
  Bool.rec (motive := fun _ => ℕ) (ih p a b c d q f g h i j l m n) 0 (Nat.beq p 0)

def ssplit02 (ih : WF) (pos a b c d e f g h i j l m n : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add (nmax g (Nat.add a c)) (nmin h (Nat.add b d))) 1) fun q => let p := ih (Nat.add pos 4) a b c d e f g q i j l m (Nat.lor n 1)
  Bool.rec (motive := fun _ => ℕ) (ih p a b c d e f q h i j l m (Nat.lor n 1)) 0 (Nat.beq p 0)

def ssplit03 (ih : WF) (pos a b c d e f g h i j l m n : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add (nmax i (Nat.add (Nat.add a c) e)) (nmin j (Nat.add (Nat.add b d) f))) 1) fun q => let p := ih (Nat.add pos 4) a b c d e f g h i q l m (Nat.lor n 2)
  Bool.rec (motive := fun _ => ℕ) (ih p a b c d e f g h q j l m (Nat.lor n 2)) 0 (Nat.beq p 0)

def ssplit13 (ih : WF) (pos a b c d e f g h i j l m n : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add (nmax l (Nat.add c e)) (nmin m (Nat.add d f))) 1) fun q => let p := ih (Nat.add pos 4) a b c d e f g h i j l q (Nat.lor n 4)
  Bool.rec (motive := fun _ => ℕ) (ih p a b c d e f g h i j q m (Nat.lor n 4)) 0 (Nat.beq p 0)

section
variable {ih : WF} (hih : WalkOK ih) (pos : ℕ)
include hih
set_option hygiene false in
/-- a split node's link: unfold, then the generic midpoint split -/
macro "pc_spl " n:ident c:term : term =>
  `(fun s h => by simp only [U, $n:ident, forceR_eq] at h; exact sp_ok hih (pos := pos) $c h ⟨rfl, rfl, rfl, rfl⟩ ⟨rfl, rfl, rfl, rfl⟩)
theorem gsplit0_ok : CovK (gsplit0 ih pos) := pc_spl gsplit0 (cov_gmid 0 (n := 3) rfl rfl (by decide))
theorem gsplit1_ok : CovK (gsplit1 ih pos) := pc_spl gsplit1 (cov_gmid 1 (n := 3) rfl rfl (by decide))
theorem gsplit2_ok : CovK (gsplit2 ih pos) := pc_spl gsplit2 (cov_gmid 2 (n := 3) rfl rfl (by decide))
theorem ssplit02_ok : CovK (ssplit02 ih pos) := pc_spl ssplit02 (cov_smid 0 (n := 3) rfl rfl (by decide))
theorem ssplit03_ok : CovK (ssplit03 ih pos) := pc_spl ssplit03 (cov_smid 1 (n := 3) rfl rfl (by decide))
theorem ssplit13_ok : CovK (ssplit13 ih pos) := pc_spl ssplit13 (cov_smid 2 (n := 3) rfl rfl (by decide))
end

/-- a split node: axis `0 … 2` a gap, `3 … 5` a pair (pair order) -/
def splitAx (ih : WF) (pos ax : ℕ) : ST :=
  Bool.rec (motive := fun _ => ST) (Bool.rec (motive := fun _ => ST) (Bool.rec (motive := fun _ => ST) (Bool.rec (motive := fun _ => ST) (Bool.rec (motive := fun _ => ST) (Bool.rec (motive := fun _ => ST) (zK) (ssplit13 ih pos) (Nat.beq ax 5)) (ssplit03 ih pos) (Nat.beq ax 4)) (ssplit02 ih pos) (Nat.beq ax 3)) (gsplit2 ih pos) (Nat.beq ax 2)) (gsplit1 ih pos) (Nat.beq ax 1)) (gsplit0 ih pos) (Nat.beq ax 0)

theorem splitAx_ok {ih : WF} (hih : WalkOK ih) (pos ax : ℕ) : CovK (splitAx ih pos ax) :=
  brec_dep (fun _ => brec_dep (fun _ => brec_dep (fun _ => brec_dep (fun _ => brec_dep (fun _ => brec_dep (fun _ => zK_ok) (fun _ => ssplit13_ok hih pos)) (fun _ => ssplit03_ok hih pos)) (fun _ => ssplit02_ok hih pos)) (fun _ => gsplit2_ok hih pos)) (fun _ => gsplit1_ok hih pos)) (fun _ => gsplit0_ok hih pos)

-- (5) bound tightening, one pass per pair (Jacobi), then the continuation; `pos` when the effective range is empty

def fb02 (pos : ℕ) (k : ST) (a b c d e f g h i j l m n : ℕ) : ℕ :=
  forceR (Nat.add a c) fun sl => forceR (Nat.add b d) fun su => forceR (nmax g sl) fun Le => forceR (nmin h su) fun Ue =>
  Bool.rec (motive := fun _ => ℕ) (fb1 a b Le su Ue sl fun a' b' => fb1 c d Le su Ue sl fun c' d' => k a' b' c' d' e f g h i j l m n) pos (Nat.blt Ue Le)

def fb03 (pos : ℕ) (k : ST) (a b c d e f g h i j l m n : ℕ) : ℕ :=
  forceR (Nat.add (Nat.add a c) e) fun sl => forceR (Nat.add (Nat.add b d) f) fun su => forceR (nmax i sl) fun Le => forceR (nmin j su) fun Ue =>
  Bool.rec (motive := fun _ => ℕ) (fb1 a b Le su Ue sl fun a' b' => fb1 c d Le su Ue sl fun c' d' => fb1 e f Le su Ue sl fun e' f' => k a' b' c' d' e' f' g h i j l m n) pos (Nat.blt Ue Le)

def fb13 (pos : ℕ) (k : ST) (a b c d e f g h i j l m n : ℕ) : ℕ :=
  forceR (Nat.add c e) fun sl => forceR (Nat.add d f) fun su => forceR (nmax l sl) fun Le => forceR (nmin m su) fun Ue =>
  Bool.rec (motive := fun _ => ℕ) (fb1 c d Le su Ue sl fun c' d' => fb1 e f Le su Ue sl fun e' f' => k a b c' d' e' f' g h i j l m n) pos (Nat.blt Ue Le)

/-- one tightening pass of pair `c` -/
def fbD (c pos : ℕ) (k : ST) : ST :=
  Bool.rec (motive := fun _ => ST) (Bool.rec (motive := fun _ => ST) (fb02 pos k) (fb03 pos k) (Nat.beq (Nat.land (Nat.shiftRight c 0) 1) 1)) (Bool.rec (motive := fun _ => ST) (fb13 pos k) (k) (Nat.beq (Nat.land (Nat.shiftRight c 0) 1) 1)) (Nat.beq (Nat.land (Nat.shiftRight c 1) 1) 1)
/-- the passes of the pairs in the mask `m` (its set bits, lowest first: pair order), at most `fuel` of them -/
def fbL (pos : ℕ) (k : ST) (fuel : ℕ) : ℕ → ST :=
  Nat.rec (motive := fun _ => ℕ → ST) (fun _ => k)
    (fun _ ih m => Bool.rec (motive := fun _ => ST)
      (forceT (Nat.land m (Nat.sub m 1)) fun m' => fbD (Nat.log2 (Nat.sub m m')) pos (ih m')) k (Nat.beq m 0)) fuel
/-- the tightening of a node: 2 rounds over the pairs ever split (the mask `M`; the others cannot tighten) -/
def fbN (pos : ℕ) (k : ST) : ST := fun a b c d e f g h i j l m n => fbL pos (fbL pos (k) 3 n) 3 n a b c d e f g h i j l m n

theorem fb_ok {k : ST} (hk : CovK k) {t : ℕ} (ht : t < 3) {s : St} {pos : ℕ}
    {m : ℕ} (h : Bool.rec (motive := fun _ => ℕ) (U k (ofCl (fbC PR (toCl s) t) m)) pos (femp PR (toCl s) t) ≠ 0) :
    Covered (toCl s) := by
  intro g hg
  obtain ⟨he, hg'⟩ := fb_gen hPR rfl rfl ht hg
  rw [he] at h
  exact ofCl_ok hk ((imap_length _ _ _).trans rfl) ((imap_length _ _ _).trans rfl) rfl rfl h g hg'

section
variable {pos : ℕ} {k : ST} (hk : CovK k)
include hk
set_option hygiene false in
/-- a tightening pass's link: unfold, then the generic pass -/
macro "pc_fbl " n:ident t:num : term =>
  `(fun _ h => by simp only [U, $n:ident, fb1, forceR_eq] at h; exact fb_ok hk (t := $t) (by decide) h)
theorem fb02_ok : CovK (fb02 pos k) := pc_fbl fb02 0
theorem fb03_ok : CovK (fb03 pos k) := pc_fbl fb03 1
theorem fb13_ok : CovK (fb13 pos k) := pc_fbl fb13 2
end

theorem fbD_ok {k : ST} (hk : CovK k) (c pos : ℕ) : CovK (fbD c pos k) :=
  brec_dep (fun _ => brec_dep (fun _ => fb02_ok hk) (fun _ => fb03_ok hk)) (fun _ => brec_dep (fun _ => fb13_ok hk) (fun _ => hk))
theorem fbL_ok {k : ST} (hk : CovK k) (pos : ℕ) : ∀ fuel m, CovK (fbL pos k fuel m)
  | 0, _ => hk
  | n + 1, _ => brec_dep (fun _ => by rw [forceT_eq]; exact fbD_ok (fbL_ok hk pos n _) _ _) fun _ => hk
theorem fbN_U {pos : ℕ} {k : ST} (s : St) : U (fbN pos k) s = U (fbL pos (fbL pos (k) 3 s.M) 3 s.M) s := by unfold U fbN; rfl
theorem fbN_ok {pos : ℕ} {k : ST} (hk : CovK k) : CovK (fbN pos k) := fun s h => fbL_ok (fbL_ok (hk) pos 3 s.M) pos 3 s.M s (fbN_U s ▸ h)

-- (3) multipliers: entries `1, c (2 bits), side, Yq (12 bits)`, closed by `0`
structure YA where
  (o P0 P1 P2 S0 S1 S2 Cp Cm : ℕ)

def MulOK (s : St) (y : YA) : Prop :=
  MulOKg 3 PR (toCl s) [y.P0, y.P1, y.P2] [y.S0, y.S1, y.S2] y.Cp y.Cm

def ystep (Ls As Bs : List ℕ) (w : ℕ) (ih : YA → YA) (y : YA) : YA :=
  forceT y.o fun o => Bool.rec (motive := fun _ => YA) ⟨(Nat.add o 1), y.P0, y.P1, y.P2, y.S0, y.S1, y.S2, y.Cp, y.Cm⟩
    (forceT (Nat.land (Nat.shiftRight w (Nat.add o 1)) 3) fun c => Bool.rec (motive := fun _ => YA) ⟨(Nat.add o 16), y.P0, y.P1, y.P2, y.S0, y.S1, y.S2, y.Cp, y.Cm⟩
      (forceT (Nat.mul SIG (Nat.land (Nat.shiftRight w (Nat.add o 4)) 4095)) fun Y =>
       forceT (Nat.land (Nat.shiftRight w (Nat.add o 3)) 1) fun sd =>
       forceT (Bool.rec (motive := fun _ => ℕ) Y 0 (Nat.beq sd 1)) fun Ylo => forceT (Bool.rec (motive := fun _ => ℕ) 0 Y (Nat.beq sd 1)) fun Yhi =>
       forceT (pI PR c) fun i => forceT (pJ PR c) fun j => forceT (sumR Ls i (Nat.sub j i)) fun sl =>
       ih ⟨(Nat.add o 16), (Nat.add y.P0 (Nat.mul Ylo (ind (inr 0 i j)))), (Nat.add y.P1 (Nat.mul Ylo (ind (inr 1 i j)))), (Nat.add y.P2 (Nat.mul Ylo (ind (inr 2 i j)))), (Nat.add y.S0 (Nat.mul Yhi (ind (inr 0 i j)))), (Nat.add y.S1 (Nat.mul Yhi (ind (inr 1 i j)))), (Nat.add y.S2 (Nat.mul Yhi (ind (inr 2 i j)))), (Nat.add (Nat.add y.Cp (Nat.mul Ylo (Nat.sub sl (As.getD c 0)))) (Nat.mul Yhi (Nat.sub (Bs.getD c 0) sl))), (Nat.add (Nat.add y.Cm (Nat.mul Ylo (Nat.sub (As.getD c 0) sl))) (Nat.mul Yhi (Nat.sub sl (Bs.getD c 0))))⟩)
      (Nat.blt c 3))
    (Nat.beq (Nat.land (Nat.shiftRight w o) 1) 1)

def ydec (Ls As Bs : List ℕ) (w fuel : ℕ) : YA → YA :=
  Nat.rec (motive := fun _ => YA → YA) (fun y => y) (fun _ ih => ystep Ls As Bs w ih) fuel

theorem MulOK_zero (s : St) (o : ℕ) : MulOK s ⟨o, 0, 0, 0, 0, 0, 0, 0, 0⟩ := fun _ _ => by simp

theorem ystep_ok (s : St) (w : ℕ) {ih : YA → YA} (hih : ∀ y, MulOK s y → MulOK s (ih y)) (y : YA) (h : MulOK s y) :
    MulOK s (ystep (toCl s).L (toCl s).A (toCl s).B w ih y) := by
  unfold ystep
  simp only [forceT_eq]
  exact brec_dep (fun _ => h) fun _ => brec_dep (fun _ => h) fun hc => hih _ (mul_step hPR rfl rfl h (Nat.blt_eq.mp hc) _ _)

theorem ydec_ok (s : St) (w : ℕ) : ∀ (fuel : ℕ) (y : YA), MulOK s y → MulOK s (ydec (toCl s).L (toCl s).A (toCl s).B w fuel y)
  | 0, _, h => h
  | n + 1, y, h => ystep_ok s w (ydec_ok s w n) y h

/-- (3) the minorant leaf on the polytope cell (`mcheckG` unrolled): per term its kind, weight and points on its
effective range; the accumulated multipliers `P, S, Cp, Cm` -/
def mcheckP (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (f : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (s : St)
