theorem PCE6_cert_full : ∀ x0 x1 x2 x3 x4 x5 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 → 0 ≤ x5 →
    (PCE6.cN : ℝ) / PCE6.SA ≤ PCE6.G x0 x1 x2 x3 x4 x5 := by
  intro x0 x1 x2 x3 x4 x5 h0 h1 h2 h3 h4 h5
  have hg : ∀ r < 6, 0 ≤ (fun r => [x0, x1, x2, x3, x4, x5].getD r 0) r := by
    intro r hr; interval_cases r <;> simpa
  have h := PCE6Data.cert _ hg
  simp only [AMW.Cert.PCell.PgL] at h
  rw [PCE6.Fg_G] at h
  rw [div_le_iff₀ (by norm_num [PCE6.SA])]
