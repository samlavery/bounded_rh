def PTN (x : ℕ) : ℕ := ptl [(28160, 0x956ecead58fc593b1b3ebd0f), (34996, 0x76ec0e83777f1978000131e0), (57344, 0x7c8e5a2471dccdd709345e72), (65186, 0x787f1f0475ec08fa00635e82), (67240, 0x7730e06b773a4793000005c4), (68480, 0x7684d4a977e6535400233d0d), (69556, 0x760885007862a2fe00726081), (99408, 0x772e38cd773cef32000022be), (100224, 0x76fe5e68776cc9970007ff7c), (132688, 0x76fd1b9a776e0c65000eb6bc), (164976, 0x77233baf7747ec500002537e), (166880, 0x76fdc7ab776d6053001845c4), (167136, 0x76f9743a7771b3c5001ccd51), (167584, 0x76f25e517778c9ae00258381), (199744, 0x77041d9e77670a61001c4de0), (223232, 0x777016c476fb113b0033f08a)] x
theorem PTN_ok : PTF PTN := ptl_sound _ (by decide +kernel)
/-- the point function: an added point, else `PC8C5BFData`'s table (the triples both tables hold are identical) -/
def PT (x : ℕ) : ℕ := forceR (PTN x) fun v => Bool.rec (motive := fun _ => ℕ) v (AMW.Cert.PC8C5BFData.PT x) (Nat.beq v 0)
theorem ptS : PTF PT := fun x => by
  unfold PT; rw [forceR_eq]
  cases Nat.beq (PTN x) 0
  · exact PTN_ok x
  · exact AMW.Cert.PC8C5BFData.ptS x

