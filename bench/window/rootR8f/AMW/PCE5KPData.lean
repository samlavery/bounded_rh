noncomputable section

namespace AMW.Cert

/-- **the truncated-window certificate** on every point with nonnegative gaps -/
theorem PCE5KP_cert_full : ∀ x0 x1 x2 x3 x4 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 →
    (PCE5KP.cN : ℝ) / PCE5KP.SA ≤ PCE5KP.G x0 x1 x2 x3 x4 := by
  intro x0 x1 x2 x3 x4 h0 h1 h2 h3 h4
  have hg : ∀ r < 5, 0 ≤ (fun r => [x0, x1, x2, x3, x4].getD r 0) r := by
    intro r hr; interval_cases r <;> simpa
  have h := PCE5KPData.cert _ hg
  simp only [AMW.Cert.PCell.PgL] at h
  rw [PCE5KP.Fg_G] at h
  rw [div_le_iff₀ (by norm_num [PCE5KP.SA])]
  linarith

end AMW.Cert

