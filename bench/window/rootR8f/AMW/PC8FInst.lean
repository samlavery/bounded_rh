/-- T1 at a node, then the continuation -/
def T1 (pos : ℕ) (k : ST) : ST := tm (tr0 (tr1 (tr2 (tr3 (tr4 (tr5 (tr6 (tr7 (tr8 (tr9 (tr10 (tr11 (tr12 (tr13 (tr14 (tr15 (tr16 (tr17 (tr18 (tr19 (tr20 (tr21 (tr22 (tr23 (tr24 (tr25 (tr26 (tr27 (tr28 (tr29 (tr30 (tr31 (tr32 (tr33 (tr34 (tr35 (tr36 (tr37 (tr38 (tr39 (tr40 (tr41 (tr42 (tr43 (tr44 (tr45 (tr46 (tr47 (tr48 (tr49 (tr50 (tr51 (tr52 (tr53 (tr54 (tr55 (tm (te pos k))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

theorem te_ok {k : ST} (hk : CovK k) (pos : ℕ) : CovK (te pos k) := fun s h g hg => by
  have h' : Bool.rec (motive := fun _ => ℕ) (U k s) pos (gempG (toCl s) 7 || pempG (toCl s) 21) ≠ 0 := h
  rw [gemp_false hg 7 le_rfl, pemp_false hg 21 le_rfl] at h'
  exact hk s h' g hg

theorem tm_ok {k : ST} (hk : CovK k) : CovK (tm k) := fun s h g hg => by
  have h' : U k (ofCl (matC PR (toCl s)) s.M) ≠ 0 := by simp only [U, tm, forceR_eq] at h; exact h
  exact ofCl_ok hk rfl rfl ((imap_length _ _ _).trans rfl) ((imap_length _ _ _).trans rfl) h' g
    (mat_gen hPR ⟨rfl, rfl, rfl, rfl⟩ hg).2

/-- a triple's link: the kernel step is `triC` on the slots `a b d` -/
theorem tri_ok {k : ST} (hk : CovK k) {a b d : ℕ} (ht : TriOk 7 PR a b d) {s : St}
    (h : U k (ofCl (triC 7 (toCl s) a b d) s.M) ≠ 0) : Covered (toCl s) := fun g hg => by
  have hl : ClLen 7 21 (triC 7 (toCl s) a b d) := triC_len (Q := 7) (n := 21) (c := toCl s) ⟨rfl, rfl, rfl, rfl⟩ a b d
  exact ofCl_ok hk hl.1 hl.2.1 hl.2.2.1 hl.2.2.2 h g (tri_gen ht ⟨rfl, rfl, rfl, rfl⟩ hg).2
