import AMW.DECertSOS
import AMW.DEDataProto

/-! ###### AMW/DESOSR8Proto — `certC cR8proto ≥ 0` on ℝ by an integer Fejér–Riesz certificate (am-cert)

The factor `a_j = AL[j]/DC` (`DC = 10^16`) is the minimum-phase Fejér–Riesz factor of `C − 1/10000000`
(cepstral method on 2^20 points, `bench/window/desos/desos_fact.py`), rounded. The exact check (`9216` integer
products) gives `certC cR8proto ≥ m_C = MZ/(E·DC²) = 9.323914e-08`. ###### -/

noncomputable section

open Finset

namespace AMW.DE

namespace SOSR8proto

def AL : List ℤ := [680786051238032, 844890211705296, 902969575605221, 1091991420816810, 1239441331251324, 1380081026535279, 1523972557540049, 1649325858684501, 1739834811682605, 1816225257561267, 1866934262224508, 1901715856786606, 1919322662857746, 1947587610400487, 1980744656292368, 1971569483778969, 1945046291838280, 1907535242054284, 1868777829658016, 1844126927696454, 1838482498680594, 1838341176640198, 1817093821641236, 1788168865232270, 1765414589483150, 1694825510986590, 1730450642966012, 1778485299496240, 1836229140440046, 1917339675183027, 1981066536258358, 2042832879465484, 871028930662442, 718105319801820, 756944754426134, 505589709637306, 319700822889940, 154848841465213, -11283920240835, -21283168144724, -48867457215129, -93269730054451, -93516737201503, -98617240981675, -108430807996618, -115790500079707, -132844115142405, -119577659873056, -101028667048023, -71339367880038, -61130905627019, -42141327688360, -14871369969289, -30019873810315, -20398475578986, 5433040079010, 17577705203251, 56012752597658, 20491368922482, -27954884356936, -85357144986903, -166297681883556, -230590359629517, -293944027049155, 200145759484258, 188018430582531, 90969063417231, 153649622928141, 191241228529223, 215484029809082, 237301079229992, 123449800119877, 60093399829356, 28085614177748, -22282942280485, -52130857842277, -59972106579064, -81168929971721, -96944950671810, -101079074403352, -92999195542403, -85554460554764, -56725636702367, -51050423318740, -72338933796576, -57243646654499, -45472564813639, -42236003053226, -30822225352399, 81482, 22750, -36883, -95049, -149567, -198379, -239536]
def AC (j : ℕ) : ℤ := AL.getD j 0
def DC : ℕ := 10000000000000000
def MZC : ℤ := 800918095265643054649909274654801920000000

theorem AC_zero : ∀ j, cR8proto.n ≤ j → AC j = 0 := by
  intro j hj
  unfold AC
  exact List.getD_eq_default _ _ (by simpa [AL, cR8proto, PLCert.n] using hj)

/-- **the certificate check** -/
theorem chk : MZC ≤ AMW.DESOS.resZ cR8proto.Y AC cR8proto.E DC cR8proto.n 0
    - 2 * ∑ k ∈ Ico 1 cR8proto.n, |AMW.DESOS.resZ cR8proto.Y AC cR8proto.E DC cR8proto.n k| := by
  decide +kernel

end SOSR8proto

/-- **`certC cR8proto ≥ 0` on ℝ** (obligation G) -/
theorem certG_R8proto : CertGNonneg cR8proto :=
  certG_of_int cR8proto SOSR8proto.AC SOSR8proto.DC (by decide) (by norm_num [SOSR8proto.DC]) SOSR8proto.AC_zero SOSR8proto.MZC
    (by decide) SOSR8proto.chk

-- ĝ(0) ≤ g(0) does not hold for this data (σ = -266290237977/1374389534720000000); not emitted

end AMW.DE

end
