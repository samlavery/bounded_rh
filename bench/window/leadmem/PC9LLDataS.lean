theorem PC9LL_G_rev (x0 x1 x2 x3 x4 x5 x6 x7 : ℝ) : PC9LL.G x7 x6 x5 x4 x3 x2 x1 x0 = PC9LL.G x0 x1 x2 x3 x4 x5 x6 x7 := by
